{
  "extends": "astro/tsconfigs/strict",
  "exclude": ["dist", "node_modules", ".audit", "media", "test-results"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] },
    "strictNullChecks": true,
    "allowJs": true
  }
}
