---
import CopySnippet from './CopySnippet.astro';
import AsciiSpecCanvas from './AsciiSpecCanvas.astro';
---

<section class="pt-10 pb-14 md:pt-14 md:pb-20 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col lg:flex-row items-center gap-10 lg:gap-12">

    <!-- Columna de texto (más ancha: el titular debe caber en 3 líneas exactas) -->
    <div class="flex-1 lg:flex-[1.2] min-w-0 flex flex-col items-center lg:items-start text-center lg:text-left">

      <!-- Eyebrow editorial: regla corta + término técnico (eco del anillo de calibración del logo) -->
      <div class="flex items-center gap-3 text-xs font-mono uppercase tracking-[0.2em] text-primary-muted">
        <span class="block h-px w-8 bg-border-active" aria-hidden="true"></span>
        <span data-i18n="hero.eyebrow">Spec-Driven Development</span>
      </div>

      <!-- Titular con jerarquía tipográfica: 3 líneas exactas (contexto / concepto clave / cierre) -->
      <h1 class="mt-4 text-4xl sm:text-5xl font-medium tracking-tight text-primary max-w-[24ch] leading-[1.08]">
        <span class="block" data-i18n="hero.titleL">Desarrollo guiado por</span>
        <span class="block font-extrabold text-accent" data-i18n="hero.titleWord">especificaciones</span>
        <span class="block" data-i18n="hero.titleR">para agentes de código.</span>
      </h1>

      <!-- Subtítulo Enfocado en Mecánica y Contratos Técnicos -->
      <p class="mt-4 text-base sm:text-lg md:text-xl text-primary-muted max-w-[52ch] leading-relaxed mx-auto lg:mx-0" data-i18n="hero.subtitle">
        Contratos técnicos versionados en Git: alcance delimitado por tarea y verificación con los tests de tu repositorio.
      </p>

      <!-- Caja de Comando npx con CopySnippet -->
      <div class="mt-6 w-full flex flex-col items-center lg:items-start gap-3" id="instalar">
        <CopySnippet command="npx --yes omni-spec@latest init" />
        <!-- Tags mono sin separadores sueltos (wrap seguro: nada de "·" colgantes) -->
        <div class="flex flex-wrap items-center justify-center lg:justify-start gap-x-4 gap-y-1.5 text-xs font-mono text-primary-muted mt-2">
          <span data-i18n="hero.tag1">Sin dependencias externas (Node.js ESM)</span>
          <span data-i18n="hero.tag2">100% local en tu repositorio</span>
          <span data-i18n="hero.tag3">Licencia MIT</span>
        </div>
      </div>

    </div>

    <!-- Columna visual: lienzo interactivo de partículas ASCII (figura OmniSpec que sigue al cursor) -->
    <div class="w-full lg:w-auto lg:flex-[0.8] flex justify-center">
      <AsciiSpecCanvas />
    </div>

  </div>
</section>
