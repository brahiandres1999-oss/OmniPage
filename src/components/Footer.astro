---
import { translations } from '../i18n/translations';
import { omniSpecRelease } from '../data/omnispec';
const t = translations.es;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const repo = 'https://github.com/brahiandres1999-oss/omni-spec';
---
<footer class="site-footer">
  <div class="page-shell">
    <div class="footer-main">
      <div class="footer-about">
        <a class="brand" href={base + '/'}><img src={base + '/assets/omni-spec-icon.svg'} width="32" height="32" alt="" /><span>OmniSpec</span></a>
        <p class="body-copy" data-i18n="footer.desc">{t['footer.desc']}</p>
        <a class="release-link" href={base + '/changelog/'}>{omniSpecRelease.version} <span aria-hidden="true">↗</span></a>
      </div>
      <nav class="footer-links" aria-label="Recursos" data-i18n-aria="footer.resources">
        <a href={base + '/docs/'} data-i18n="nav.docs">{t['nav.docs']}</a>
        <a href={base + '/changelog/'} data-i18n="nav.changelog">{t['nav.changelog']}</a>
        <a href={repo}>GitHub <span aria-hidden="true">↗</span></a>
        <a href={repo + '/issues'} data-i18n="footer.issues">{t['footer.issues']}</a>
        <a href={repo + '/blob/main/LICENSE'} data-i18n="footer.license">{t['footer.license']}</a>
      </nav>
    </div>
    <div class="footer-bottom">
      <p data-i18n="footer.note">{t['footer.note']}</p>
    </div>
  </div>
</footer>
