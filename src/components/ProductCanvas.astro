---
import { translations } from '../i18n/translations';
import Icon from './Icon.astro';
const t = translations.es;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<section id="canvas" class="section-space demo-section">
  <div class="page-shell">
    <div class="section-intro">
      <p class="eyebrow" data-i18n="demo.eyebrow">{t['demo.eyebrow']}</p>
      <h2 class="section-title" data-i18n="demo.title">{t['demo.title']}</h2>
      <p class="body-copy" data-i18n="demo.intro">{t['demo.intro']}</p>
    </div>

    <div class="diptych-grid">
      <!-- PANEL 1: Terminal Interactiva Paso a Paso -->
      <article class="diptych-card terminal-surface" id="term-interactive-card" role="region" aria-label="Terminal interactiva de OmniSpec" tabindex="0">
        <header class="diptych-header">
          <div class="terminal-dots" aria-hidden="true">
            <span class="dot-red"></span>
            <span class="dot-yellow"></span>
            <span class="dot-green"></span>
          </div>
          <span class="diptych-title font-mono">terminal — PowerShell</span>
          <span class="diptych-badge font-mono" id="term-step-badge">
            <span data-locale="es">Entrada</span>
            <span data-locale="en" hidden>Input</span>
          </span>
        </header>

        <div class="diptych-body font-mono terminal-interactive-wrapper">
          <div class="term-scroll-container">
