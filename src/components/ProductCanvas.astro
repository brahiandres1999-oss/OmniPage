---
import { translations } from '../i18n/translations';
import Icon from './Icon.astro';
const t = translations.es;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<section id="canvas" class="section-space demo-section">
  <div class="page-shell">
    <div class="section-intro">
      <p class="eyebrow" data-i18n="demo.eyebrow">{t['demo.eyebrow']}</p>
      <h2 class="section-title" data-i18n="demo.title">{t['demo.title']}</h2>
      <p class="body-copy" data-i18n="demo.intro">{t['demo.intro']}</p>
    </div>

    <p class="demo-disclaimer small-note" data-i18n="demo.disclaimer">Simulación interactiva con datos de ejemplo. No ejecuta comandos ni modifica tu proyecto.</p>
    <!-- DOCK FLOTANTE DE 4 MODOS OPERATIVOS DEL WORKBENCH -->
    <div class="flex justify-center mb-8 overflow-x-auto py-1">
      <nav class="workbench-dock" role="tablist" aria-label="Modos de la demostración" data-i18n-aria="demo.modesLabel">
        <button type="button" role="tab" class="dock-tab is-active" id="dock-sdd" aria-controls="workbench-panel" aria-selected="true" data-mode="sdd">
          <span class="dock-led bg-blue-500"></span>
          <span class="tabular-nums" data-locale="es">1. Lienzo SDD</span>
          <span class="tabular-nums" data-locale="en" hidden>1. SDD Canvas</span>
        </button>
        <button type="button" role="tab" class="dock-tab" id="dock-multiagent" aria-controls="workbench-panel" tabindex="-1" aria-selected="false" data-mode="multiagent">
          <span class="dock-led bg-purple-500"></span>
          <span class="tabular-nums" data-locale="es">2. Multi-Agente & FTS5</span>
          <span class="tabular-nums" data-locale="en" hidden>2. Multi-Agent & FTS5</span>
        </button>
        <button type="button" role="tab" class="dock-tab" id="dock-guardian" aria-controls="workbench-panel" tabindex="-1" aria-selected="false" data-mode="guardian">
          <span class="dock-led bg-amber-500"></span>
          <span class="tabular-nums" data-locale="es">3. Guardian Anti-Slop</span>
          <span class="tabular-nums" data-locale="en" hidden>3. Guardian Anti-Slop</span>
        </button>
        <button type="button" role="tab" class="dock-tab" id="dock-verify" aria-controls="workbench-panel" tabindex="-1" aria-selected="false" data-mode="verify">
          <span class="dock-led bg-emerald-500"></span>
          <span class="tabular-nums" data-locale="es">4. Verificación Criptográfica</span>
          <span class="tabular-nums" data-locale="en" hidden>4. Cryptographic Verify</span>
        </button>
      </nav>
    </div>

    <div class="diptych-grid" id="workbench-panel" role="tabpanel" aria-labelledby="dock-sdd" tabindex="0">
      <!-- PANEL 1: Terminal Interactiva Paso a Paso -->
      <article class="diptych-card terminal-surface" id="term-interactive-card" role="region" aria-label="Terminal interactiva de OmniSpec" data-i18n-aria="demo.terminalLabel" tabindex="0">
        <header class="diptych-header">
          <div class="terminal-dots" aria-hidden="true">
            <span class="dot-red"></span>
            <span class="dot-yellow"></span>
            <span class="dot-green"></span>
          </div>
          <span class="diptych-title font-mono">terminal — PowerShell (my-pay-service)</span>
          <span class="diptych-badge font-mono tabular-nums" id="term-step-badge">Herramientas (1/3)</span>
        </header>

        <div class="diptych-body font-mono terminal-interactive-wrapper">
