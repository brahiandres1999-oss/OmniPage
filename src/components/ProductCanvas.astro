---
import { translations } from '../i18n/translations';
import AgentLogo from './AgentLogo.astro';
import '../styles/workbench.css';
const t=translations.es;
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<section id="canvas" class="section-space demo-section">
  <div class="page-shell">
    <div class="section-intro"><p class="eyebrow" data-i18n="demo.eyebrow">{t['demo.eyebrow']}</p><h2 class="section-title" data-i18n="demo.title">{t['demo.title']}</h2><p class="body-copy" data-i18n="demo.intro">{t['demo.intro']}</p></div>
    <link rel="stylesheet" href={base+'/assets/vscode/codicons.css'}/>
    <div id="lifecycle-demo" class="lifecycle-demo" data-stage="-1">
      <div id="demo-film" class="demo-film" hidden>
        <video id="workflow-video" muted playsinline loop preload="none" poster={base+'/media/omni-workflow-poster.png'} aria-label="Recorrido de OmniSpec en VS Code" data-i18n-aria="film.video"><source data-video-src={base+'/media/omni-workflow.mp4'} type="video/mp4"/></video>
      </div>
      <div id="omni-ide" class="ide-shell lifecycle-shell">
        <div class="ide-titlebar" aria-hidden="true"><span class="ide-menu-text">File &nbsp; Edit &nbsp; Selection &nbsp; View &nbsp; Go &nbsp; Run</span><span class="ide-search"><i class="codicon codicon-search"></i> OmniPage</span><span class="ide-window-layout"><i class="codicon codicon-layout"></i><i class="codicon codicon-chrome-minimize"></i><i class="codicon codicon-chrome-maximize"></i><i class="codicon codicon-chrome-close"></i></span></div>
        <div class="lifecycle-workbench">
          <div class="ide-activity" aria-hidden="true"><i class="codicon codicon-files"></i><i class="codicon codicon-search"></i><i class="codicon codicon-source-control"></i><i class="codicon codicon-extensions"></i><AgentLogo agent="claude" size={22}/><span class="ide-activity-bottom"><i class="codicon codicon-account"></i><i class="codicon codicon-settings-gear"></i></span></div>
          <details class="lifecycle-explorer" open>
            <summary><span data-i18n="sim.explorer">Explorador</span><span id="demo-file-count">3</span><span class="explorer-chevron" aria-hidden="true">⌄</span></summary>
            <div class="demo-tree-project">OMNIPAGE <span data-i18n="sim.example">ejemplo</span></div>
            <div id="demo-file-tree" class="demo-file-tree"></div>
          </details>
          <div class="ide-center lifecycle-center">
            <div class="lifecycle-editor-tab"><span id="demo-tab-icon" class="seti-icon" aria-hidden="true"></span><span id="demo-file-tab">package.json</span><i class="codicon codicon-close" aria-hidden="true"></i><span class="editor-language" id="demo-file-type">JSON</span></div>
            <div class="ide-breadcrumb" id="demo-file-path">package.json</div>
            <div class="lifecycle-editor" role="region" aria-label="Contenido del archivo seleccionado" data-i18n-aria="sim.editor" tabindex="0"><div id="demo-line-numbers" class="ide-line-numbers" aria-hidden="true"></div><pre><code id="demo-file-content"></code></pre></div>
            <div class="lifecycle-terminal"><div class="ide-terminal-tabs"><strong>TERMINAL</strong><span data-i18n="sim.terminalLabel">Salida del ejemplo</span></div><pre tabindex="0" role="region" aria-label="Terminal del ejemplo" data-i18n-aria="sim.terminal"><code id="demo-terminal-content"></code></pre></div>
          </div>
          <div class="ide-agent lifecycle-agent">
            <div class="ide-panel-title"><span><span data-demo-logo="claude"><AgentLogo agent="claude" size={18}/></span><span data-demo-logo="codex" hidden><AgentLogo agent="codex" size={18}/></span><span id="demo-agent-name">Claude Code</span></span><span aria-hidden="true">+ &nbsp; ···</span></div>
            <div class="lifecycle-chat">
              <p class="demo-chat-speaker" data-i18n="sim.you">Tú</p>
              <div class="ide-chat-prompt"><code id="demo-skill-command"></code><p id="demo-step-prompt" lang="es"></p></div>
              <div id="demo-agent-response" class="demo-agent-response" hidden><p id="demo-step-response" lang="es"></p><div id="demo-changed-files" class="demo-changed-files"></div></div>
              <p class="demo-ready-note" id="demo-ready-note" data-i18n="sim.ready">Ejecuta el paso para ver qué cambia.</p>
            </div>
            <div class="lifecycle-composer"><button type="button" id="demo-run"><i class="codicon codicon-play" aria-hidden="true"></i><span id="demo-run-label">Ver instalación</span><kbd aria-hidden="true">↵</kbd></button></div>
          </div>
        </div>
        <div class="ide-statusbar"><span><span aria-hidden="true">⌁</span> main <span class="demo-status-divider">/</span><span data-i18n="sim.feature">feature: copiar comando</span></span><span id="demo-progress">0 / 10</span></div>
      </div><span data-ide-end hidden></span>
      <div class="demo-player-controls"><button type="button" id="film-toggle" class="demo-player-icon" aria-label="Pausar recorrido" data-i18n-aria="film.pause" title="Pausar recorrido"><i class="codicon codicon-debug-pause" aria-hidden="true"></i></button><button type="button" id="demo-reset" class="demo-player-icon" aria-label="Reiniciar recorrido" data-i18n-aria="sim.reset" title="Reiniciar recorrido"><i class="codicon codicon-refresh" aria-hidden="true"></i></button><span id="demo-current-skill">/omni-init</span><button type="button" id="demo-explore" class="demo-explore" data-i18n="film.explore">Explorar archivos</button><button type="button" id="demo-watch" class="demo-explore" data-i18n="film.watch" hidden>Ver recorrido</button></div>
      <p id="demo-live-status" class="sr-only" role="status" aria-live="polite" aria-atomic="true" lang="es"></p>
    </div>
    <p class="small-note demo-disclosure" data-i18n="demo.label">{t['demo.label']}</p>
    <noscript><style>#lifecycle-demo{display:none}</style><p class="body-copy">El recorrido interactivo necesita JavaScript. <a href={import.meta.env.BASE_URL.replace(/\/$/,'')+'/docs/#flujo-descubrimiento'}>Consulta el flujo y los archivos en la documentación.</a></p></noscript>
  </div>
</section>
<script>
  import '../scripts/lifecycle';
</script>
