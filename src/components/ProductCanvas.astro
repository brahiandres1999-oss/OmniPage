<script>
  import { enableTabKeyboard } from '../scripts/tabs';
  // Terminal Interactive Wizard Steps
  const steps = Array.from(document.querySelectorAll<HTMLElement>('.term-step'));
  const badge = document.getElementById('term-step-badge');
  const treeBadge = document.getElementById('tree-sync-badge');
  const stepIndicator = document.getElementById('term-step-indicator');
  const hintText = document.getElementById('term-hint-text');
  const statusBar = document.getElementById('term-status-bar');

  let currentStep = 1;
  let currentMode: 'sdd' | 'multiagent' | 'guardian' | 'verify' = 'sdd';

  const stepBadgeLabels = [
    { es: 'Entrada', en: 'Input' },
    { es: 'Herramientas (1/3)', en: 'Tools (1/3)' },
    { es: 'Modo (2/3)', en: 'Mode (2/3)' },
    { es: 'Confirmación (3/3)', en: 'Confirmation (3/3)' },
    { es: 'Instalado v0.9.0', en: 'Installed v0.9.0' }
  ];

  const modeBadgeLabels: Record<'multiagent' | 'guardian' | 'verify', { es: string; en: string }> = {
    multiagent: { es: 'Memoria FTS5', en: 'FTS5 Memory' },
    guardian: { es: 'Guardian Anti-Slop', en: 'Guardian Anti-Slop' },
    verify: { es: 'HMAC Verificado', en: 'HMAC Verified' }
  };

  const hintLabels = [
    { es: 'Presiona Enter para ejecutar', en: 'Press Enter to run' },
    { es: 'Presiona Enter para continuar', en: 'Press Enter to continue' },
    { es: 'Presiona Enter para continuar', en: 'Press Enter to continue' },
    { es: 'Presiona Enter para preparar', en: 'Press Enter to prepare' },
    { es: 'Presiona Enter para reiniciar', en: 'Press Enter to restart' }
  ];

  function getActiveLang(): 'es' | 'en' {
    return document.documentElement.lang === 'en' ? 'en' : 'es';
  }

  function updateTexts() {
    const lang = getActiveLang();
    if (badge) {
      badge.textContent = currentMode === 'sdd'
        ? stepBadgeLabels[currentStep][lang]
        : modeBadgeLabels[currentMode][lang];
    }
    if (stepIndicator) {
      stepIndicator.textContent = `${currentStep} / 4`;
    }
    if (hintText) {
      hintText.textContent = hintLabels[currentStep][lang];
    }
    if (treeBadge) {
      const synced = currentMode === 'verify' || currentStep === 4;
      if (!synced) {
        treeBadge.textContent = lang === 'en' ? 'Pre-installation' : 'Pre-instalación';
        treeBadge.classList.remove('is-synced');
      } else {
        treeBadge.textContent = lang === 'en' ? 'Installed [OK]' : 'Instalado [OK]';
        treeBadge.classList.add('is-synced');
      }
    }
  }

  function showStep(index: number) {
    currentStep = index;
    steps.forEach((step, idx) => {
      step.hidden = idx !== currentStep;
    });
    updateTexts();

    // Keep terminal scrolled to top so the logo and header are always visible
    const termContainer = document.querySelector<HTMLElement>('.term-scroll-container');
    if (termContainer) {
      termContainer.scrollTop = 0;
    }
  }

  function nextStep() {
    if (currentStep < 4) showStep(currentStep + 1);
    else showStep(0);
  }

  updateTexts();

  // Click on status bar advances step
  statusBar?.addEventListener('click', () => {
    nextStep();
  });

  // Focused key navigation on the interactive card only (no global window hijacking)
  const termCard = document.getElementById('term-interactive-card');
  termCard?.addEventListener('keydown', (e) => {
    if (e.target === termCard && currentMode === 'sdd' && (e.key === 'Enter' || e.key === ' ')) {
      e.preventDefault();
      nextStep();
    }
  });

  // Listen to language switch events
  window.addEventListener('omni:language-change', () => {
    updateTexts();
  });

  // Explorer Tabs
  const expTabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.exp-tab'));
  const expViews = Array.from(document.querySelectorAll<HTMLElement>('.exp-view'));

  expTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const targetId = tab.getAttribute('data-exp-target');
      expTabs.forEach(t => {
        const isCurrent = t === tab;
        t.setAttribute('aria-selected', isCurrent ? 'true' : 'false');
        t.classList.toggle('is-active', isCurrent);
      });
      expViews.forEach(view => {
        view.hidden = view.id !== targetId;
      });
    });
  });

  // Workbench Dock Mode Switching
  const dockTabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.dock-tab'));
  const modePanes = Array.from(document.querySelectorAll<HTMLElement>('.workbench-mode-pane'));

  dockTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const mode = (tab.getAttribute('data-mode') || 'sdd') as 'sdd' | 'multiagent' | 'guardian' | 'verify';
      currentMode = mode;
      document.getElementById('workbench-panel')?.setAttribute('aria-labelledby', tab.id);
      dockTabs.forEach(t => {
        const isCurrent = t === tab;
        t.setAttribute('aria-selected', isCurrent ? 'true' : 'false');
        t.classList.toggle('is-active', isCurrent);
      });

      if (mode === 'sdd') {
        modePanes.forEach(p => p.hidden = true);
        steps.forEach((step, idx) => step.hidden = idx !== currentStep);
        if (statusBar) statusBar.style.display = 'flex';
        updateTexts();
        (document.getElementById('tab-tree') as HTMLButtonElement | null)?.click();
      } else {
        steps.forEach(step => step.hidden = true);
        if (statusBar) statusBar.style.display = 'none';
        modePanes.forEach(pane => {
          pane.hidden = pane.id !== `mode-pane-${mode}`;
        });
        updateTexts();
        if (mode === 'multiagent') {
          (document.getElementById('tab-context') as HTMLButtonElement | null)?.click();
        } else if (mode === 'guardian') {
          (document.getElementById('tab-const') as HTMLButtonElement | null)?.click();
        } else if (mode === 'verify') {
          (document.getElementById('tab-tree') as HTMLButtonElement | null)?.click();
        }
      }
    });
  });
  enableTabKeyboard(expTabs);
  enableTabKeyboard(dockTabs);
</script>
