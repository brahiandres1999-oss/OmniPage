  };

  function setupIdeWorkspace() {
    // 1. Selector de Archivos del IDE
    const fileButtons = document.querySelectorAll<HTMLButtonElement>('.ide-file-btn');
    const breadcrumbEl = document.getElementById('ide-breadcrumb');
    const filenameEl = document.getElementById('editor-filename');
    const codeEl = document.getElementById('editor-code');

    // Inicializar con spec.md
    if (codeEl && fileContents.spec) {
      codeEl.textContent = fileContents.spec.code;
    }

    fileButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const fileKey = btn.getAttribute('data-file');
        if (!fileKey || !fileContents[fileKey]) return;

        const data = fileContents[fileKey];

        // Actualizar estilos activos de archivos
        fileButtons.forEach((b) => {
          b.classList.remove('bg-surface-elevated', 'dark:bg-white/10', 'text-primary', 'font-semibold');
          b.classList.add('text-primary-muted');
        });
        btn.classList.add('bg-surface-elevated', 'dark:bg-white/10', 'text-primary', 'font-semibold');
        btn.classList.remove('text-primary-muted');

        // Actualizar editor y breadcrumb
        if (breadcrumbEl) {
          breadcrumbEl.innerHTML = data.path.replace(data.name, `<span class="text-primary font-semibold">${data.name}</span>`);
        }
        if (filenameEl) {
          filenameEl.textContent = data.name;
        }
        if (codeEl) {
          codeEl.textContent = data.code;
        }
      });
    });

    // 2. Selector de la Suite de 9 Comandos en Terminal
    const skillButtons = document.querySelectorAll<HTMLButtonElement>('.skill-tab-btn');
    const cmdEl = document.getElementById('terminal-cmd');
    const outputEl = document.getElementById('terminal-output');

    skillButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const skillKey = btn.getAttribute('data-skill');
        if (!skillKey || !skillLogs[skillKey]) return;

        const log = skillLogs[skillKey];

        skillButtons.forEach((b) => {
          b.classList.remove('bg-primary', 'text-background', 'font-bold', 'border-primary');
          b.classList.add('bg-surface', 'text-primary-muted', 'border-border/70');
          b.setAttribute('aria-selected', 'false');
        });

        btn.classList.add('bg-primary', 'text-background', 'font-bold', 'border-primary');
        btn.classList.remove('bg-surface', 'text-primary-muted', 'border-border/70');
        btn.setAttribute('aria-selected', 'true');

        if (cmdEl) cmdEl.textContent = log.cmd;
        if (outputEl) outputEl.innerHTML = log.output;
      });
    });
  }

  setupIdeWorkspace();
  document.addEventListener('astro:page-load', setupIdeWorkspace);
</script>
