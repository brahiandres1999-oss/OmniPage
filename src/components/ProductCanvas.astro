  const badge = document.getElementById('term-step-badge');
  const treeBadge = document.getElementById('tree-sync-badge');
  const stepIndicator = document.getElementById('term-step-indicator');
  const hintText = document.getElementById('term-hint-text');
  const statusBar = document.getElementById('term-status-bar');

  let currentStep = 0;

  const stepBadgeLabels = [
    { es: 'Entrada', en: 'Input' },
    { es: 'Herramientas (1/3)', en: 'Tools (1/3)' },
    { es: 'Modo (2/3)', en: 'Mode (2/3)' },
