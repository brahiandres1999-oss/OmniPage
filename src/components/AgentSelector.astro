---
import CopySnippet from './CopySnippet.astro';
import AgentLogo from './AgentLogo.astro';
import { agentsByLang } from '../data/omnispec';
import { translations } from '../i18n/translations';
const t = translations.es;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<section id="empezar" class="section-space start-section">
  <span id="instalar" class="anchor-alias" aria-hidden="true"></span>
  <div class="page-shell">
    <div class="section-intro"><p class="eyebrow" data-i18n="start.eyebrow">{t['start.eyebrow']}</p><h2 class="section-title" data-i18n="start.title">{t['start.title']}</h2><p class="body-copy" data-i18n="start.intro">{t['start.intro']}</p></div>
    <div class="start-steps">
      <article class="start-step">
        <span class="step-number" aria-hidden="true">01</span>
        <div><h3 data-i18n="start.1.title">{t['start.1.title']}</h3><p class="body-copy" data-i18n="start.1.body">{t['start.1.body']}</p>
          <CopySnippet />
          <p class="small-note" data-i18n="start.channel">{t['start.channel']}</p>
        </div>
      </article>
      <article class="start-step start-step-wide" id="agentes">
        <span class="step-number" aria-hidden="true">02</span>
        <div>
          <h3 class="max-w-[56rem]" data-i18n="start.2.title">{t['start.2.title']}</h3>
          <p class="body-copy max-w-[56rem]" data-i18n="start.2.body">{t['start.2.body']}</p>

          <div class="agent-master-detail-grid grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-start my-6">
            <!-- COLUMNA IZQUIERDA: Selector de Agentes por Tiers & Tabla -->
            <div class="lg:col-span-7 min-w-0">
              <fieldset class="agent-picker" aria-describedby="agent-hint">
                <legend class="field-label sr-only" data-i18n="start.agent">{t['start.agent']}</legend>

                <!-- Tiering de Integración de Agentes -->
                <div class="agent-tiers-container space-y-4 mb-4">
                  <!-- TIER 1 -->
                  <div>
                    <div class="flex items-center gap-2 mb-2">
                      <span class="inline-flex h-2 w-2 rounded-full bg-emerald-500" aria-hidden="true"></span>
                      <span class="font-mono text-xs font-bold text-emerald-800 dark:text-emerald-300 uppercase tracking-wider">
                        <span data-locale="es">Tier 1: Integración Profunda de Tareas &amp; Subagentes</span>
                        <span data-locale="en" hidden>Tier 1: Deep Task &amp; Subagent Integration</span>
                      </span>
                    </div>
                    <div class="agent-options">
                      {['antigravity', 'claude', 'codex', 'cursor', 'opencode'].map(key => {
                        const agent = agentsByLang.es[key];
                        return (
                          <label class="agent-option" for={`agent-radio-${key}`}>
                            <input type="radio" id={`agent-radio-${key}`} name="agent-choice" value={key} checked={key === 'claude'} />
                            <span class="agent-option-content">
                              <AgentLogo agent={key} size={18} />
                              <span data-agent-label={key}>{agent.title}</span>
                            </span>
                          </label>
                        );
                      })}
                    </div>
                  </div>

                  <!-- TIER 2 & 3 -->
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                      <div class="flex items-center gap-2 mb-2">
                        <span class="inline-flex h-2 w-2 rounded-full bg-amber-500" aria-hidden="true"></span>
                        <span class="font-mono text-xs font-bold text-amber-800 dark:text-amber-300 uppercase tracking-wider">
                          <span data-locale="es">Tier 2: Detección de Terminal</span>
                          <span data-locale="en" hidden>Tier 2: Terminal Detection</span>
                        </span>
                      </div>
                      <div class="agent-options">
                        {['kilo', 'gemini'].map(key => {
                          const agent = agentsByLang.es[key];
                          return (
                            <label class="agent-option" for={`agent-radio-${key}`}>
                              <input type="radio" id={`agent-radio-${key}`} name="agent-choice" value={key} />
                              <span class="agent-option-content">
                                <AgentLogo agent={key} size={18} />
                                <span data-agent-label={key}>{agent.title}</span>
                              </span>
                            </label>
                          );
                        })}
                      </div>
                    </div>

                    <div>
                      <div class="flex items-center gap-2 mb-2">
                        <span class="inline-flex h-2 w-2 rounded-full bg-blue-500" aria-hidden="true"></span>
                        <span class="font-mono text-xs font-bold text-blue-800 dark:text-blue-300 uppercase tracking-wider">
                          <span data-locale="es">Tier 3: TTY Shell Universal</span>
                          <span data-locale="en" hidden>Tier 3: Universal TTY Shell</span>
                        </span>
                      </div>
                      <div class="agent-options">
                        {['copilot', 'universal'].map(key => {
                          const agent = agentsByLang.es[key];
                          return (
                            <label class="agent-option" for={`agent-radio-${key}`}>
                              <input type="radio" id={`agent-radio-${key}`} name="agent-choice" value={key} />
                              <span class="agent-option-content">
                                <AgentLogo agent={key} size={18} />
                                <span data-agent-label={key}>{agent.title}</span>
                              </span>
                            </label>
                          );
                        })}
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Tabla Técnica de Capacidades por Nivel -->
                <p class="small-note" data-i18n="agents.tableHint">Compara las integraciones. Desplaza la tabla para ver todas las columnas.</p>
                <div tabindex="0" role="region" aria-label="Comparación de integraciones" data-i18n-aria="agents.tableLabel" class="overflow-x-auto rounded-lg border border-[rgb(var(--border-rgb)/0.14)] bg-[rgb(var(--bg-surface))] my-4 p-3 font-mono text-[11px] tabular-nums">
                  <table class="w-full text-left border-collapse">
                    <thead>
                      <tr class="border-b border-[rgb(var(--border-rgb)/0.12)] text-[rgb(var(--text-secondary))] text-[10px] uppercase tracking-wider">
                        <th scope="col" class="py-1.5 px-2">
                          <span data-locale="es">Nivel</span>
                          <span data-locale="en" hidden>Tier</span>
                        </th>
                        <th scope="col" class="py-1.5 px-2">
                          <span data-locale="es">Subagentes</span>
                          <span data-locale="en" hidden>Subagents</span>
                        </th>
                        <th scope="col" class="py-1.5 px-2">
                          <span data-locale="es">Memoria FTS5</span>
                          <span data-locale="en" hidden>FTS5 Memory</span>
                        </th>
                        <th scope="col" class="py-1.5 px-2">Guardian Hook</th>
                        <th scope="col" class="py-1.5 px-2">
                          <span data-locale="es">Firma HMAC</span>
                          <span data-locale="en" hidden>HMAC Signature</span>
                        </th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-[rgb(var(--border-rgb)/0.08)] text-[rgb(var(--text-secondary))]">
                      <tr>
                        <td class="py-1.5 px-2 font-bold text-emerald-800 dark:text-emerald-400">Tier 1 (Deep)</td>
                        <td class="py-1.5 px-2 text-emerald-800 dark:text-emerald-400">
                          <span data-locale="es">✔ Nativo</span>
                          <span data-locale="en" hidden>✔ Native</span>
                        </td>
                        <td class="py-1.5 px-2 text-emerald-800 dark:text-emerald-400">
                          <span data-locale="es">✔ Sincronizado</span>
                          <span data-locale="en" hidden>✔ Synchronized</span>
                        </td>
                        <td class="py-1.5 px-2 text-emerald-800 dark:text-emerald-400">✔ Pre-commit</td>
                        <td class="py-1.5 px-2 text-emerald-800 dark:text-emerald-400">
                          <span data-locale="es">✔ Criptográfico</span>
                          <span data-locale="en" hidden>✔ Cryptographic</span>
                        </td>
                      </tr>
                      <tr>
                        <td class="py-1.5 px-2 font-bold text-amber-800 dark:text-amber-400">Tier 2 (Terminal)</td>
                        <td class="py-1.5 px-2 text-[rgb(var(--text-secondary))]">—</td>
                        <td class="py-1.5 px-2 text-emerald-800 dark:text-emerald-400">✔ CLI JSON</td>
                        <td class="py-1.5 px-2 text-emerald-800 dark:text-emerald-400">✔ Pre-commit</td>
                        <td class="py-1.5 px-2 text-emerald-800 dark:text-emerald-400">
                          <span data-locale="es">✔ Criptográfico</span>
                          <span data-locale="en" hidden>✔ Cryptographic</span>
                        </td>
                      </tr>
                      <tr>
                        <td class="py-1.5 px-2 font-bold text-blue-800 dark:text-blue-400">Tier 3 (TTY)</td>
                        <td class="py-1.5 px-2 text-[rgb(var(--text-secondary))]">—</td>
                        <td class="py-1.5 px-2 text-[rgb(var(--text-secondary))]">—</td>
                        <td class="py-1.5 px-2 text-emerald-800 dark:text-emerald-400">✔ Git Hook</td>
                        <td class="py-1.5 px-2 text-emerald-800 dark:text-emerald-400">
                          <span data-locale="es">✔ Criptográfico</span>
                          <span data-locale="en" hidden>✔ Cryptographic</span>
                        </td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </fieldset>

              <p id="agent-hint" class="small-note" data-i18n="start.selectHint">{t['start.selectHint']}</p>
            </div>

            <!-- COLUMNA DERECHA: Panel de Invocación Sticky (Sincronizado sin scroll) -->
            <div class="lg:col-span-5 lg:sticky lg:top-24 min-w-0">
              <div id="agent-guidance" class="agent-guidance-card" hidden aria-live="polite" aria-atomic="true">
                <div class="guidance-header">
                  <span id="agent-card-title" class="guidance-agent-title"></span>
                  <span id="agent-format-badge" class="guidance-format-badge"></span>
                </div>
                <p id="agent-description" class="guidance-desc"></p>
                <p id="antigravity-plugin-guide" hidden><a class="quiet-link text-xs" href={base + '/docs/#antigravity-plugin'} data-i18n="start.pluginGuide">{t['start.pluginGuide']}</a></p>
                <CopySnippet id="agent-invocation" command="" prefix="›" />
                <div class="guidance-meta font-mono">
                  <div class="flex flex-wrap items-baseline gap-1.5 min-w-0">
                    <span class="meta-label" data-i18n="start.paths">{t['start.paths']}:</span>
                    <code id="agent-path" class="meta-path break-all"></code>
                  </div>
                  <a href={base + '/docs/#recuperacion'} class="quiet-link recovery-link text-[rgb(var(--accent))]" data-i18n="start.recovery">{t['start.recovery']}</a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </article>
      <article class="start-step">
        <span class="step-number" aria-hidden="true">03</span>
        <div><h3 data-i18n="start.3.title">{t['start.3.title']}</h3><p class="body-copy" data-i18n="start.3.body">{t['start.3.body']}</p><blockquote class="example-request" data-i18n="start.prompt">{t['start.prompt']}</blockquote><a class="quiet-link" href={base + '/docs/#quickstart'}><span data-i18n="start.docs">{t['start.docs']}</span><span aria-hidden="true">↗</span></a></div>
      </article>
      <article class="start-step" id="mantenimiento">
        <span class="step-number" aria-hidden="true">04</span>
        <div>
          <h3 data-i18n="start.maintenance.title">{t['start.maintenance.title']}</h3>
          <p class="body-copy" data-i18n="start.maintenance.body">{t['start.maintenance.body']}</p>
          <div style="display: flex; flex-direction: column; gap: 0.5rem; margin-top: 0.75rem;">
            <CopySnippet command="npx --yes omni-spec doctor" prefix="$" />
            <CopySnippet command="npx --yes omni-spec update --dry-run" prefix="$" />
          </div>
          <p class="small-note" style="margin-top: 0.5rem;" data-i18n="start.maintenance.note">{t['start.maintenance.note']}</p>
        </div>
      </article>
    </div>
    <p class="start-scope small-note" data-i18n="start.scope">{t['start.scope']}</p>
  </div>
</section>

<style>
  .agent-picker {
    padding: 0;
    margin: 1rem 0 0 0;
    border: 0;
    min-width: 0;
  }
  .agent-options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .agent-option {
    position: relative;
    cursor: pointer;
  }
  .agent-option input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }
  .agent-option-content {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.35rem;
    padding: 0.4rem 0.8rem;
    border: 1px solid rgb(var(--border-rgb) / var(--border-subtle-alpha));
    border-radius: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: rgb(var(--text-secondary));
    background: rgb(var(--bg-surface) / 0.7);
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }
  .agent-option:hover .agent-option-content {
    background: rgb(var(--bg-surface));
    color: rgb(var(--text-primary));
    border-color: rgb(var(--text-secondary));
  }
  .agent-option input:checked + .agent-option-content {
    border-color: rgb(var(--text-primary));
    background: rgb(var(--bg-surface-elevated));
    color: rgb(var(--text-primary));
    box-shadow: inset 0 0 0 1px rgb(var(--text-primary));
  }
  .agent-option input:focus-visible + .agent-option-content {
    outline: 2px solid rgb(var(--focus));
    outline-offset: 2px;
  }
  #agent-hint {
    margin-block: 0.75rem 0.5rem;
    font-size: 0.8125rem;
    color: rgb(var(--text-secondary));
  }
  .agent-guidance-card {
    border: 1px solid rgb(var(--border-rgb) / var(--border-active-alpha));
    border-radius: 0.75rem;
    background: rgb(var(--bg-surface));
    box-shadow: 0 4px 20px rgb(0 0 0 / 0.04);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .guidance-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-bottom: 0.65rem;
    border-bottom: 1px solid rgb(var(--border-rgb) / var(--border-subtle-alpha));
  }
  .guidance-agent-title {
    font-size: 1rem;
    font-weight: 600;
    color: rgb(var(--text-primary));
  }
  .guidance-format-badge {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono, monospace);
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    background: rgb(var(--bg-base));
    border: 1px solid rgb(var(--border-rgb) / var(--border-subtle-alpha));
    color: rgb(var(--text-secondary));
  }
  .guidance-desc {
    font-size: 0.875rem;
    line-height: 1.55;
    color: rgb(var(--text-secondary));
    margin: 0;
  }
  .guidance-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.8125rem;
    padding-top: 0.65rem;
    border-top: 1px solid rgb(var(--border-rgb) / var(--border-subtle-alpha));
  }
  .meta-label {
    color: rgb(var(--text-secondary));
  }
  .meta-path {
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    background: rgb(var(--bg-base));
    color: rgb(var(--text-secondary));
    overflow-wrap: anywhere;
  }
  .recovery-link {
    margin-left: auto;
    font-size: 0.75rem;
  }
  @media (max-width: 640px) {
    .guidance-meta {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.35rem;
    }
    .recovery-link {
      margin-left: 0;
    }
  }
</style>

<script>
  import { agentsByLang } from '../data/omnispec';
  import { getLanguage } from '../scripts/preferences';
  const choices = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="agent-choice"]'));
  const guidance = document.getElementById('agent-guidance')!;
  let displayedAgent = '';
  const render = () => {
    const catalog = agentsByLang[getLanguage()];
    document.querySelectorAll<HTMLElement>('[data-agent-label]').forEach(label => {
      if (catalog[label.dataset.agentLabel!]) label.textContent = catalog[label.dataset.agentLabel!].title;
    });
    const key = choices.find(choice => choice.checked)?.value || 'claude';
    const agent = catalog[key];
    guidance.hidden = !agent;
    document.getElementById('antigravity-plugin-guide')!.hidden = key !== 'antigravity';
    if (!agent) return;
    const invocation = document.querySelector('#agent-invocation [data-copy-text]')!;
    const changed = displayedAgent !== key || invocation.textContent !== agent.invocation;
    displayedAgent = key;

    const cardTitle = document.getElementById('agent-card-title');
    if (cardTitle) cardTitle.textContent = agent.title;
    const formatBadge = document.getElementById('agent-format-badge');
    if (formatBadge) formatBadge.textContent = agent.format;

    document.getElementById('agent-description')!.textContent = agent.desc;
    invocation.textContent = agent.invocation;
    document.getElementById('agent-path')!.textContent = agent.path;
    if (!changed) return;
    const status = guidance.querySelector<HTMLElement>('.copy-status')!;
    status.textContent = '';
    delete status.dataset.i18n;
    guidance.querySelector<HTMLButtonElement>('.copy-select')!.hidden = true;
    const copyLabel = guidance.querySelector<HTMLElement>('[data-copy-label]')!;
    copyLabel.dataset.i18n = 'copy.copy';
    copyLabel.textContent = getLanguage() === 'es' ? 'Copiar' : 'Copy';
  };
  choices.forEach(choice => choice.addEventListener('change', render));
  window.addEventListener('omni:language-change', render);
  render();
</script>
<noscript><p class="page-shell body-copy">Consulta las invocaciones de cada herramienta en la <a href={base + '/docs/#adaptadores-agentes'}>documentación de integraciones</a>.</p></noscript>
