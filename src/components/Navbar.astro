---
import { translations } from '../i18n/translations';
const t = translations.es;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [
  { href: base + '/#canvas', key: 'nav.howItWorks' },
  { href: base + '/#empezar', key: 'nav.start' },
  { href: base + '/docs/', key: 'nav.docs' },
  { href: base + '/changelog/', key: 'nav.changelog' }
];
---
<header class="site-header">
  <div class="page-shell header-row">
    <a class="brand" href={base + '/'} aria-label={t['nav.home']} data-i18n-aria="nav.home">
      <img src={base + '/assets/omni-spec-icon.svg'} width="36" height="36" alt="" />
      <span>OmniSpec</span>
    </a>
    <nav class="desktop-nav" aria-label={t['nav.label']} data-i18n-aria="nav.label">
      {links.map(link => <a href={link.href} data-i18n={link.key} aria-current={Astro.url.pathname.replace(/\/$/, '') === link.href.replace(/\/$/, '') ? 'page' : undefined}>{t[link.key]}</a>)}
    </nav>
    <div class="header-actions">
      <button class="icon-button language-button" id="lang-toggle-btn" type="button" aria-label="Cambiar a inglés">EN</button>
      <button class="icon-button" id="theme-toggle-btn" type="button" aria-label="Usar tema claro">
        <svg class="theme-sun" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="4"/><path stroke-linecap="round" d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.4 1.4m11.2 11.2L19 19M5 19l1.4-1.4M17.6 6.4 19 5"/></svg>
        <svg class="theme-moon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M20.4 15.4A9 9 0 0 1 8.6 3.6 9 9 0 1 0 20.4 15.4Z"/></svg>
      </button>
      <details class="mobile-nav">
        <summary data-i18n="nav.menu">{t['nav.menu']}</summary>
        <nav aria-label={t['nav.label']} data-i18n-aria="nav.label">
          {links.map(link => <a href={link.href} data-i18n={link.key}>{t[link.key]}</a>)}
          <a href="https://github.com/brahiandres1999-oss/omni-spec" data-i18n="nav.github">{t['nav.github']}</a>
        </nav>
      </details>
    </div>
  </div>
</header>
<script>
  const menu = document.querySelector<HTMLDetailsElement>('.mobile-nav');
  menu?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
  });
  menu?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => { menu.open = false; }));
  document.addEventListener('click', (event) => {
    if (menu?.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
  });
</script>
