---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header class="sticky top-0 z-50 w-full border-b border-border bg-background/90 backdrop-blur-md transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Brand / Logotipo y Versión Cohesionados -->
    <div class="flex items-center gap-2 sm:gap-3 min-w-0 shrink">
      <a href={`${base}/`} class="flex items-center gap-2 sm:gap-2.5 group shrink-0" aria-label="OmniSpec Inicio">
        <img 
          src={`${base}/assets/omni-spec-icon.svg`} 
          alt="OmniSpec Logo" 
          class="w-9 h-9 sm:w-10 sm:h-10 object-contain transition-transform group-hover:scale-105 shrink-0" 
        />
        <span class="font-bold text-lg sm:text-xl tracking-tight text-primary group-hover:text-accent transition-colors truncate">OmniSpec</span>
      </a>

      <!-- Badge Changelog Trigger Contiguo: visible a partir de sm: -->
      <a
        href={`${base}/changelog`}
        class="hidden sm:inline-flex items-center gap-1.5 text-xs font-mono px-2 py-0.5 rounded bg-surface-elevated hover:bg-surface-hover border border-border text-primary-muted hover:text-accent font-medium transition-colors group/ver shrink-0"
        title="Ver novedades de la versión (Changelog)"
        aria-label="Ver historial de versiones (Changelog)"
        data-i18n-title="nav.versionTitle"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
        <span>v0.6.1</span>
      </a>
    </div>

    <!-- Enlaces de navegación Desktop Reducidos y Clave -->
    <nav aria-label="Navegación principal" class="hidden md:flex items-center gap-6 lg:gap-8 text-sm font-medium text-primary-muted">
      <a href={`${base}/#canvas`} class="hover:text-primary transition-colors" data-i18n="nav.howItWorks">Cómo Funciona</a>
      <a href={`${base}/#leyes`} class="hover:text-primary transition-colors" data-i18n="nav.constitution">Constitución</a>
      <a href={`${base}/#perfiles`} class="hover:text-primary transition-colors" data-i18n="nav.profiles">Perfiles</a>
      <a href={`${base}/docs`} class="text-primary hover:text-accent transition-colors font-semibold" data-i18n="nav.docs">Docs</a>
      <a href={`${base}/changelog`} class="hover:text-primary transition-colors" data-i18n="nav.changelog">Changelog</a>
    </nav>

    <!-- Acciones: Iconos limpios + CTA Principal -->
    <div class="flex items-center gap-0.5 sm:gap-2 shrink-0">
      <!-- 1. Selector de Idioma (Icono Globo sin texto ni caja) -->
      <button
        type="button"
        id="lang-toggle-btn"
        class="p-2 text-primary-muted hover:text-primary transition-transform active:scale-90 focus:outline-none focus-visible:ring-1 focus-visible:ring-accent rounded-lg"
        aria-label="Cambiar idioma entre Español e Inglés"
        title="Cambiar idioma (ES / EN)"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="10"></circle>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
          <path d="M2 12h20"></path>
        </svg>
      </button>

      <!-- 2. Theme Switcher (Icono Sol / Luna sin texto ni caja) -->
      <button
        type="button"
        id="theme-toggle-btn"
        class="p-2 text-primary-muted hover:text-primary transition-transform active:scale-90 focus:outline-none focus-visible:ring-1 focus-visible:ring-accent rounded-lg"
        aria-label="Alternar modo claro y oscuro"
        title="Alternar modo claro y oscuro"
      >
        <!-- Icono Sol (en Dark Mode) -->
        <svg class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="5"></circle>
          <path stroke-linecap="round" d="M12 1v2m0 18v2M4.22 4.22l1.42 1.42m12.72 12.72l1.42 1.42M1 12h2m18 0h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path>
        </svg>
        <!-- Icono Luna (en Light Mode) -->
        <svg class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
        </svg>
      </button>

      <!-- 3. GitHub (Icono Octocat sin texto ni caja) — visible a partir de sm: -->
      <a 
        href="https://github.com/brahiandres1999-oss/omni-spec" 
        target="_blank" 
        rel="noopener noreferrer"
        class="hidden sm:inline-flex p-2 text-primary-muted hover:text-primary transition-transform active:scale-90 focus:outline-none focus-visible:ring-1 focus-visible:ring-accent rounded-lg"
        aria-label="Repositorio en GitHub"
        title="GitHub"
      >
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
        </svg>
      </a>

      <!-- CTA Principal: Copia comando y guía a configuración de agentes — visible a partir de sm: -->
      <button 
        type="button"
        id="nav-install-btn" 
        class="hidden sm:inline-flex ml-1 items-center justify-center gap-1.5 px-3 py-1.5 rounded-lg text-xs sm:text-sm font-semibold bg-primary text-background hover:opacity-90 transition-all active:scale-95 cursor-pointer"
        aria-label="Copiar comando de instalación e ir a configuración de agentes"
        title="Copiar comando npx omni-spec init"
      >
        <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
        </svg>
        <span id="nav-install-text" data-i18n="nav.installCli">Instalar CLI</span>
      </button>

      <!-- Botón de Menú Móvil -->
      <button
        type="button"
        id="mobile-menu-btn"
        class="md:hidden p-2 rounded-lg text-primary-muted hover:text-primary transition-colors active:scale-95 focus:outline-none focus-visible:ring-1 focus-visible:ring-accent ml-0.5 sm:ml-1"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Abrir menú de navegación"
      >
        <!-- Icono Hamburguesa -->
        <svg id="hamburger-icon" class="w-5 h-5 block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <!-- Icono Cerrar (X) -->
        <svg id="close-icon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Panel Desplegable Móvil -->
  <div 
    id="mobile-menu" 
    class="hidden md:hidden border-b border-border bg-background/95 backdrop-blur-md px-4 py-5 transition-all"
  >
    <!-- CTA Principal de Instalación en Móvil -->
    <div class="pb-3 mb-2 border-b border-border/70">
      <button
        type="button"
        id="mobile-install-btn"
        class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg text-xs font-semibold bg-primary text-background hover:opacity-90 transition-all active:scale-95 cursor-pointer shadow-sm"
        aria-label="Copiar comando de instalación e ir a configuración de agentes"
      >
        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
        </svg>
        <span id="mobile-install-text" data-i18n="nav.installCli">Instalar CLI</span>
      </button>
    </div>

    <nav class="flex flex-col gap-3.5 text-sm font-medium text-primary">
      <a href={`${base}/#canvas`} class="mobile-nav-link py-2 px-3 rounded-lg hover:bg-surface transition-colors" data-i18n="nav.howItWorks">Cómo Funciona</a>
      <a href={`${base}/#caos-vs-spec`} class="mobile-nav-link py-2 px-3 rounded-lg hover:bg-surface transition-colors" data-i18n="nav.theProblem">El Problema</a>
      <a href={`${base}/#leyes`} class="mobile-nav-link py-2 px-3 rounded-lg hover:bg-surface transition-colors" data-i18n="nav.constitution">La Constitución</a>
      <a href={`${base}/#perfiles`} class="mobile-nav-link py-2 px-3 rounded-lg hover:bg-surface transition-colors" data-i18n="nav.profiles">Perfiles</a>
      <a href={`${base}/#agentes`} class="mobile-nav-link py-2 px-3 rounded-lg hover:bg-surface transition-colors" data-i18n="nav.agents">Agentes</a>
      <a href={`${base}/docs`} class="mobile-nav-link py-2 px-3 rounded-lg hover:bg-surface transition-colors font-semibold text-accent" data-i18n="nav.docs">Documentación</a>
      <a href={`${base}/changelog`} class="mobile-nav-link py-2 px-3 rounded-lg hover:bg-surface transition-colors" data-i18n="nav.changelog">Changelog</a>
      <a href={`${base}/#faq`} class="mobile-nav-link py-2 px-3 rounded-lg hover:bg-surface transition-colors" data-i18n="nav.faq">FAQ</a>
      
      <div class="pt-3 mt-1 border-t border-border flex items-center justify-between">
        <a 
          href="https://github.com/brahiandres1999-oss/omni-spec" 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-xs font-mono text-primary-muted hover:text-primary transition-colors py-1.5"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
          </svg>
          <span data-i18n="nav.viewGithub">Ver en GitHub</span>
        </a>
        <a
          href={`${base}/changelog`}
          class="text-xs font-mono px-2 py-0.5 rounded bg-surface-elevated border border-border text-primary-muted hover:text-accent transition-colors"
        >
          v0.6.1
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  import { translations, type Language } from '../i18n/translations';

  function applyLanguage(lang: Language) {
    const dict = translations[lang] || translations.es;
    document.documentElement.lang = lang;
    localStorage.setItem('omni-lang', lang);

    // Update text elements
    const i18nElements = document.querySelectorAll<HTMLElement>('[data-i18n]');
    i18nElements.forEach((el) => {
      const key = el.getAttribute('data-i18n');
      if (key && dict[key]) {
        if (dict[key].includes('<') && dict[key].includes('>')) {
          el.innerHTML = dict[key];
        } else {
          el.textContent = dict[key];
        }
      }
    });

    // Update title attributes
    const i18nTitles = document.querySelectorAll<HTMLElement>('[data-i18n-title]');
    i18nTitles.forEach((el) => {
      const key = el.getAttribute('data-i18n-title');
      if (key && dict[key]) {
        el.setAttribute('title', dict[key]);
      }
    });

    // Update aria-label attributes
    const i18nAria = document.querySelectorAll<HTMLElement>('[data-i18n-aria]');
    i18nAria.forEach((el) => {
      const key = el.getAttribute('data-i18n-aria');
      if (key && dict[key]) {
        el.setAttribute('aria-label', dict[key]);
      }
    });

    // Update lang button title
    const langBtn = document.getElementById('lang-toggle-btn');
    if (langBtn) {
      langBtn.setAttribute('title', lang === 'es' ? 'Switch to English' : 'Cambiar a Español');
    }

    // Broadcast custom event for other dynamic components
    window.dispatchEvent(new CustomEvent('omni:language-change', { detail: { lang } }));
  }

  function setupNavbar() {
    const navHeader = document.querySelector('header');
    if (!navHeader || navHeader.dataset.bound === 'true') {
      const savedLang = (localStorage.getItem('omni-lang') as Language) || 'es';
      if (savedLang === 'en') {
        applyLanguage('en');
      }
      return;
    }
    navHeader.dataset.bound = 'true';

    // Theme Switcher
    const themeBtn = document.getElementById('theme-toggle-btn');
    if (themeBtn) {
      themeBtn.addEventListener('click', () => {
        const isDark = document.documentElement.classList.contains('dark');
        if (isDark) {
          document.documentElement.classList.remove('dark');
          localStorage.setItem('omni-theme', 'light');
        } else {
          document.documentElement.classList.add('dark');
          localStorage.setItem('omni-theme', 'dark');
        }
      });
    }

    // Language Toggle
    const langBtn = document.getElementById('lang-toggle-btn');
    if (langBtn) {
      langBtn.addEventListener('click', () => {
        const currentLang = (localStorage.getItem('omni-lang') as Language) || 'es';
        const nextLang: Language = currentLang === 'es' ? 'en' : 'es';
        applyLanguage(nextLang);
      });
    }

    // Init language from storage or default
    const savedLang = (localStorage.getItem('omni-lang') as Language) || 'es';
    if (savedLang === 'en') {
      applyLanguage('en');
    }

    // Mobile Menu Toggle
    const menuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const hamburgerIcon = document.getElementById('hamburger-icon');
    const closeIcon = document.getElementById('close-icon');

    if (menuBtn && mobileMenu && hamburgerIcon && closeIcon) {
      const toggleMenu = (open?: boolean) => {
        const shouldOpen = open ?? mobileMenu.classList.contains('hidden');
        if (shouldOpen) {
          mobileMenu.classList.remove('hidden');
          menuBtn.setAttribute('aria-expanded', 'true');
          hamburgerIcon.classList.add('hidden');
          hamburgerIcon.classList.remove('block');
          closeIcon.classList.remove('hidden');
          closeIcon.classList.add('block');
        } else {
          mobileMenu.classList.add('hidden');
          menuBtn.setAttribute('aria-expanded', 'false');
          hamburgerIcon.classList.remove('hidden');
          hamburgerIcon.classList.add('block');
          closeIcon.classList.add('hidden');
          closeIcon.classList.remove('block');
        }
      };

      menuBtn.addEventListener('click', () => toggleMenu());

      // Cerrar al pulsar cualquier enlace del menú móvil
      const mobileLinks = mobileMenu.querySelectorAll('.mobile-nav-link');
      mobileLinks.forEach((link) => {
        link.addEventListener('click', () => toggleMenu(false));
      });
    }

    // Botones de instalación CLI en Navbar y Menú Móvil (copia interactiva + navegación a agentes)
    const attachInstallAction = (btnId: string, textId: string) => {
      const btn = document.getElementById(btnId);
      const text = document.getElementById(textId);
      if (!btn || !text) return;

      btn.addEventListener('click', async () => {
        const cmd = 'npx --yes omni-spec@latest init';
        const lang = (localStorage.getItem('omni-lang') as Language) || 'es';
        try {
          await navigator.clipboard.writeText(cmd);
          const originalText = text.textContent || 'Instalar CLI';
          text.textContent = lang === 'en' ? '✓ Copied!' : '✓ ¡Copiado!';
          btn.classList.add('bg-emerald-600', 'text-white');
          
          setTimeout(() => {
            text.textContent = originalText;
            btn.classList.remove('bg-emerald-600', 'text-white');
          }, 2200);

          const agentesSection = document.getElementById('agentes');
          if (agentesSection) {
            agentesSection.scrollIntoView({ behavior: 'smooth' });
          }
        } catch {
          const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
          window.location.href = `${baseUrl}/#agentes`;
        }
      });
    };

    attachInstallAction('nav-install-btn', 'nav-install-text');
    attachInstallAction('mobile-install-btn', 'mobile-install-text');
  }

  setupNavbar();
  document.addEventListener('astro:page-load', setupNavbar);
</script>
