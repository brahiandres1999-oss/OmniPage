---
interface Props { kind: 'context' | 'scope' | 'evidence' }
const { kind } = Astro.props;
---
<svg class={'artifact-illustration art-' + kind} viewBox="0 0 360 208" fill="none" aria-hidden="true" focusable="false">
  <defs><pattern id={'dots-' + kind} width="18" height="18" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r=".8" fill="currentColor" opacity=".16"/></pattern></defs>
  <rect x="1" y="1" width="358" height="206" rx="12" fill={'url(#dots-' + kind + ')'} />
  {kind === 'context' && <>
    <path d="M68 73h68m88 65h59M180 43v121" class="art-connector" stroke-dasharray="4 5"/>
    <rect x="24" y="45" width="98" height="53" rx="7" class="art-paper"/><path d="M40 62h37m-37 12h63m-63 12h44" class="art-line"/><path d="m41 97-9 11v-11" class="art-line"/>
    <rect x="240" y="113" width="96" height="54" rx="7" class="art-paper"/><path d="M256 130h41m-41 12h62m-62 12h31" class="art-line"/>
    <path d="M147 34h58l22 22v118a5 5 0 0 1-5 5h-75a5 5 0 0 1-5-5V39a5 5 0 0 1 5-5Z" class="art-paper art-primary"/>
    <path d="M204 35v24h23M159 80h47m-47 14h36m-36 14h47m-47 14h24" class="art-line"/><path d="m159 149 8 8 17-17" class="art-accent"/>
    <circle cx="80" cy="153" r="15" class="art-paper"/><path d="M80 145v9l6 3" class="art-accent"/>
  </>}
  {kind === 'scope' && <>
    <path d="M45 35v138h273V35Z" class="art-connector" stroke-dasharray="4 5"/>
    <path d="M90 47h159v120H90Z" class="art-paper art-primary"/><path d="M103 63h67m-67 14h121" class="art-line"/>
    {[0,1,2].map(i => <><rect x="104" y={96+i*21} width="11" height="11" rx="2" class="art-accent"/><path d={'M126 '+(102+i*21)+'h91'} class="art-line"/></>)}
    <rect x="218" y="25" width="65" height="32" rx="6" class="art-paper"/><path d="m234 41 6 5 14-13" class="art-accent"/>
    <path d="m292 102 14 14m0-14-14 14" class="art-line" opacity=".5"/>
    <circle cx="62" cy="172" r="16" class="art-paper"/><path d="M56 172h12m-6-6v12" class="art-accent"/>
  </>}
  {kind === 'evidence' && <>
    <path d="M109 74h50v60h65M159 108h65" class="art-connector"/>
    <rect x="30" y="43" width="94" height="94" rx="7" class="art-paper"/><path d="M44 58h38m-38 15h64" class="art-line"/><path d="m49 93 7 7 14-14m-21 31h47" class="art-accent"/>
    <rect x="211" y="40" width="120" height="132" rx="7" class="art-paper art-primary"/><path d="M227 58h67m-67 15h86" class="art-line"/>
    {[0,1,2].map(i => <><circle cx="233" cy={94+i*24} r="5" class="art-accent"/><path d={'M248 '+(94+i*24)+'h62'} class="art-line"/></>)}
    <rect x="74" y="146" width="99" height="32" rx="6" class="art-paper"/><path d="m89 157 7 5-7 5m15 0h13" class="art-accent"/>
  </>}
</svg>
