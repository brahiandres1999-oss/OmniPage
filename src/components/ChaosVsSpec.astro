---
import { translations } from '../i18n/translations';
import { skillsLoop } from '../data/skills-loop';
const t = translations.es;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section id="caos-vs-spec" class="section-space">
  <div class="page-shell">
    <!-- Header de Sección -->
    <div class="section-intro two-column-intro mb-8">
      <div>
        <p class="eyebrow" data-i18n="value.eyebrow">{t['value.eyebrow']}</p>
        <h2 class="section-title" data-i18n="value.title">{t['value.title']}</h2>
      </div>
      <p class="body-copy" data-i18n="value.intro">{t['value.intro']}</p>
    </div>

    <!-- Matriz Dialéctica Comparativa: Split Ledger unificado (sin tarjetas anidadas) -->
    <div class="comparative-matrix rounded-xl border border-[rgb(var(--border-rgb)/0.14)] overflow-hidden grid grid-cols-1 lg:grid-cols-2 divide-y lg:divide-y-0 lg:divide-x divide-[rgb(var(--border-rgb)/0.12)] mb-16 bg-[rgb(var(--bg-surface))]">
      <!-- Columna 1: Sin especificación / Vibe Coding -->
      <div class="chaos-card p-6 sm:p-7 flex flex-col justify-between bg-red-500/[0.03] dark:bg-red-950/15">
        <div>
          <div class="flex items-center justify-between gap-2 mb-3 pb-3 border-b border-red-500/15">
            <span class="font-mono text-[11px] font-semibold tracking-wide text-red-800 dark:text-red-300" data-i18n="value.chaos.badge">
              {t['value.chaos.badge']}
            </span>
            <span class="font-mono text-[10px] font-semibold tracking-wider text-red-800 dark:text-red-400 tabular-nums">
              <span data-locale="es">RIESGOS HABITUALES</span>
              <span data-locale="en" hidden>COMMON RISKS</span>
            </span>
          </div>
          <p class="text-xs text-[rgb(var(--text-secondary))] mb-5 font-mono" data-i18n="value.chaos.subtitle">{t['value.chaos.subtitle']}</p>
          
          <ul class="space-y-4">
            <li class="border-l-2 border-red-500/45 pl-3.5">
              <span class="block font-mono text-xs font-bold text-red-900 dark:text-red-300" data-i18n="value.chaos.1.tag">{t['value.chaos.1.tag']}</span>
              <p class="text-xs text-[rgb(var(--text-secondary))] mt-0.5" data-i18n="value.chaos.1.detail">{t['value.chaos.1.detail']}</p>
            </li>
            <li class="border-l-2 border-red-500/45 pl-3.5">
              <span class="block font-mono text-xs font-bold text-red-900 dark:text-red-300" data-i18n="value.chaos.2.tag">{t['value.chaos.2.tag']}</span>
              <p class="text-xs text-[rgb(var(--text-secondary))] mt-0.5" data-i18n="value.chaos.2.detail">{t['value.chaos.2.detail']}</p>
            </li>
            <li class="border-l-2 border-red-500/45 pl-3.5">
              <span class="block font-mono text-xs font-bold text-red-900 dark:text-red-300" data-i18n="value.chaos.3.tag">{t['value.chaos.3.tag']}</span>
              <p class="text-xs text-[rgb(var(--text-secondary))] mt-0.5" data-i18n="value.chaos.3.detail">{t['value.chaos.3.detail']}</p>
            </li>
          </ul>
        </div>

        <div class="mt-6 pt-4 border-t border-red-500/15 font-mono text-[11px] text-red-800 dark:text-red-300 tabular-nums">
          <div data-locale="es">
            <div class="text-[10px] text-[rgb(var(--text-secondary))] uppercase tracking-wider mb-1">Riesgos que conviene revisar:</div>
            <div>✖ Código fuera del alcance acordado</div>
            <div>✖ Falso éxito en prompts sin test ejecutable</div>
          </div>
          <div data-locale="en" hidden>
            <div class="text-[10px] text-[rgb(var(--text-secondary))] uppercase tracking-wider mb-1">Risks to check:</div>
            <div>✖ Code outside the agreed scope</div>
            <div>✖ False passes on prompts with zero runnable tests</div>
          </div>
        </div>
      </div>

      <!-- Columna 2: Motor Agéntico OmniSpec -->
      <div class="spec-card p-6 sm:p-7 flex flex-col justify-between bg-emerald-500/[0.03] dark:bg-emerald-950/15">
        <div>
          <div class="flex items-center justify-between gap-2 mb-3 pb-3 border-b border-emerald-500/15">
            <span class="font-mono text-[11px] font-semibold tracking-wide text-emerald-900 dark:text-emerald-300" data-i18n="value.spec.badge">
              {t['value.spec.badge']}
            </span>
            <span class="font-mono text-[10px] font-semibold tracking-wider text-emerald-900 dark:text-emerald-400 tabular-nums">
              <span data-locale="es">SDD DETERMINISTA</span>
              <span data-locale="en" hidden>DETERMINISTIC SDD</span>
            </span>
          </div>
          <p class="text-xs text-[rgb(var(--text-secondary))] mb-5 font-mono" data-i18n="value.spec.subtitle">{t['value.spec.subtitle']}</p>
          
          <ul class="space-y-4">
            <li class="border-l-2 border-emerald-500/55 pl-3.5">
              <span class="block font-mono text-xs font-bold text-emerald-900 dark:text-emerald-300" data-i18n="value.spec.1.tag">{t['value.spec.1.tag']}</span>
              <p class="text-xs text-[rgb(var(--text-secondary))] mt-0.5" data-i18n="value.spec.1.detail">{t['value.spec.1.detail']}</p>
            </li>
            <li class="border-l-2 border-emerald-500/55 pl-3.5">
              <span class="block font-mono text-xs font-bold text-emerald-900 dark:text-emerald-300" data-i18n="value.spec.2.tag">{t['value.spec.2.tag']}</span>
              <p class="text-xs text-[rgb(var(--text-secondary))] mt-0.5" data-i18n="value.spec.2.detail">{t['value.spec.2.detail']}</p>
            </li>
            <li class="border-l-2 border-emerald-500/55 pl-3.5">
              <span class="block font-mono text-xs font-bold text-emerald-900 dark:text-emerald-300" data-i18n="value.spec.3.tag">{t['value.spec.3.tag']}</span>
              <p class="text-xs text-[rgb(var(--text-secondary))] mt-0.5" data-i18n="value.spec.3.detail">{t['value.spec.3.detail']}</p>
            </li>
          </ul>
        </div>

        <div class="mt-6 pt-4 border-t border-emerald-500/15 font-mono text-[11px] text-emerald-900 dark:text-emerald-300 tabular-nums">
          <div data-locale="es">
            <div class="text-[10px] text-[rgb(var(--text-secondary))] uppercase tracking-wider mb-1">Evidencia para revisar:</div>
            <div>✔ Alcance y cambios registrados</div>
            <div>✔ Firma HMAC-SHA256 en verification.json</div>
          </div>
          <div data-locale="en" hidden>
            <div class="text-[10px] text-[rgb(var(--text-secondary))] uppercase tracking-wider mb-1">Evidence to review:</div>
            <div>✔ Recorded scope and changes</div>
            <div>✔ HMAC-SHA256 signature in verification.json</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Workbench Maestro-Detalle -->
    <div class="relative mx-auto my-4 w-full max-w-5xl select-none" id="skills-pipeline-diagram">
      
      <!-- Contenedor Principal del Workbench -->
      <div class="overflow-hidden rounded-2xl border border-[rgb(var(--border-rgb)/0.14)] bg-[rgb(var(--bg-surface))] shadow-sm">
        
        <!-- Barra de Cabecera Editorial -->
        <div class="flex flex-wrap items-center justify-between border-b border-[rgb(var(--border-rgb)/0.1)] px-5 py-3 sm:px-6">
          <div class="flex items-center gap-2.5">
            <span class="inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
            <span class="font-mono text-[11px] font-semibold uppercase tracking-wider text-[rgb(var(--text-tertiary))]" data-i18n="loop.fig">
              {t['loop.fig']}
            </span>
          </div>
          <div class="flex items-center gap-2">
            <span class="rounded bg-[rgb(var(--bg-surface-elevated))] px-2 py-0.5 font-mono text-[10.5px] font-medium text-[rgb(var(--text-secondary))]" data-i18n="loop.stats">
              {t['loop.stats']}
            </span>
            <span class="rounded border border-[rgb(var(--border-rgb)/0.15)] px-2 py-0.5 font-mono text-[10.5px] text-[rgb(var(--text-tertiary))]">
              DETERMINISTIC
            </span>
          </div>
        </div>

        <!-- Master-Detail Grid (Lado a Lado en Desktop, 1 sola pantalla) -->
        <div class="grid grid-cols-1 divide-y divide-[rgb(var(--border-rgb)/0.1)] md:grid-cols-12 md:divide-x md:divide-y-0">
          
          <!-- COLUMNA MASTER (Izquierda, 5 cols): Cadena de montaje interactiva -->
          <div class="p-3.5 sm:p-4.5 md:col-span-5 flex flex-col justify-between space-y-3 bg-[rgb(var(--bg-surface))]" role="tablist" aria-orientation="vertical" aria-label={t['loop.tablist.aria']} data-i18n-aria="loop.tablist.aria">
            
            <!-- ETAPA 1 -->
            <div>
              <div class="flex items-center justify-between px-1.5 pb-1">
                <span class="font-mono text-[9.5px] font-bold tracking-wider text-[rgb(var(--text-tertiary))]" data-i18n="loop.stage.1.title">
                  {t['loop.stage.1.title']}
                </span>
                <span class="font-mono text-[9px] text-[rgb(var(--text-tertiary))]" data-i18n="loop.stage.1.count">
                  {t['loop.stage.1.count']}
                </span>
              </div>
              <div class="space-y-1">
                {skillsLoop.filter(s => s.stage === 1).map((s) => (
                  <button
                    type="button"
                    role="tab"
                    id={`tab-${s.id}`}
                    aria-selected={s.id === 'specify'}
                    aria-controls="pipeline-inspector-panel"
                    tabindex={s.id === 'specify' ? 0 : -1}
                    data-skill-id={s.id}
                    class="pipeline-skill-tab group relative flex w-full items-center justify-between rounded-lg border border-transparent px-2.5 py-1.5 text-left transition-all duration-150 hover:bg-[rgb(var(--bg-surface-elevated))] active:scale-[0.99] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[rgb(var(--focus))]"
                  >
                    <div class="flex items-center gap-2 min-w-0">
                      <span class="font-mono text-[10.5px] font-semibold text-[rgb(var(--text-tertiary))] group-hover:text-[rgb(var(--text-primary))]">
                        {s.number}
                      </span>
                      <span class="shrink-0 font-mono text-[12px] font-medium text-[rgb(var(--text-primary))]">
                        {s.command}
                      </span>
                      <span class="hidden 2xl:inline-block truncate text-[10.5px] text-[rgb(var(--text-secondary))] max-w-[120px]">
                        · <span data-i18n={`loop.skill.${s.id}.short`}>{t[`loop.skill.${s.id}.short`]}</span>
                      </span>
                    </div>
                    <div class="flex items-center gap-1.5 shrink-0 ml-1.5">
                      {s.badge && (
                        <span class="rounded bg-[rgb(var(--bg-surface-elevated))] border border-[rgb(var(--border-rgb)/0.12)] px-1.5 py-0.5 font-mono text-[8.5px] font-medium text-[rgb(var(--text-secondary))]">
                          <span data-locale="es">{s.badge.es}</span>
                          <span data-locale="en" hidden>{s.badge.en}</span>
                        </span>
                      )}
                      <span class="font-mono text-[9px] text-[rgb(var(--text-secondary))]">
                        {s.size}
                      </span>
                    </div>
                  </button>
                ))}
              </div>
            </div>

            <!-- ETAPA 2 -->
            <div>
              <div class="flex items-center justify-between px-1.5 pb-1 border-t border-[rgb(var(--border-rgb)/0.08)] pt-2">
                <span class="font-mono text-[9.5px] font-bold tracking-wider text-amber-800 dark:text-amber-300" data-i18n="loop.stage.2.title">
                  {t['loop.stage.2.title']}
                </span>
                <span class="font-mono text-[9px] font-semibold text-amber-900 dark:text-amber-300" data-i18n="loop.stage.2.count">
                  {t['loop.stage.2.count']}
                </span>
              </div>
              <div class="space-y-1">
                {skillsLoop.filter(s => s.stage === 2).map((s) => (
                  <button
                    type="button"
                    role="tab"
                    id={`tab-${s.id}`}
                    aria-selected="false"
                    aria-controls="pipeline-inspector-panel"
                    tabindex="-1"
                    data-skill-id={s.id}
                    class="pipeline-skill-tab group relative flex w-full items-center justify-between rounded-lg border border-transparent px-2.5 py-1.5 text-left transition-all duration-150 hover:bg-[rgb(var(--bg-surface-elevated))] active:scale-[0.99] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[rgb(var(--focus))]"
                  >
                    <div class="flex items-center gap-2 min-w-0">
                      <span class="font-mono text-[10.5px] font-semibold text-[rgb(var(--text-tertiary))] group-hover:text-[rgb(var(--text-primary))]">
                        {s.number}
                      </span>
                      <span class="shrink-0 font-mono text-[12px] font-medium text-[rgb(var(--text-primary))]">
                        {s.command}
                      </span>
                      <span class="hidden 2xl:inline-block truncate text-[10.5px] text-[rgb(var(--text-secondary))] max-w-[120px]">
                        · <span data-i18n={`loop.skill.${s.id}.short`}>{t[`loop.skill.${s.id}.short`]}</span>
                      </span>
                    </div>
                    <div class="flex items-center gap-1.5 shrink-0 ml-1.5">
                      {s.badge && (
                        <span class={`rounded px-1.5 py-0.5 font-mono text-[8.5px] font-semibold ${s.badge.variant === 'gate' ? 'bg-amber-500/15 border border-amber-600/40 text-amber-900 dark:text-amber-300' : 'bg-[rgb(var(--bg-surface-elevated))] border border-[rgb(var(--border-rgb)/0.12)] text-[rgb(var(--text-secondary))]'}`}>
                          <span data-locale="es">{s.badge.es}</span>
                          <span data-locale="en" hidden>{s.badge.en}</span>
                        </span>
                      )}
                      <span class="font-mono text-[9px] text-[rgb(var(--text-secondary))]">
                        {s.size}
                      </span>
                    </div>
                  </button>
                ))}
              </div>
            </div>

            <!-- ETAPA 3 -->
            <div>
              <div class="flex items-center justify-between px-1.5 pb-1 border-t border-[rgb(var(--border-rgb)/0.08)] pt-2">
                <span class="font-mono text-[9.5px] font-bold tracking-wider text-emerald-800 dark:text-emerald-300" data-i18n="loop.stage.3.title">
                  {t['loop.stage.3.title']}
                </span>
                <span class="font-mono text-[9px] font-semibold text-emerald-900 dark:text-emerald-300" data-i18n="loop.stage.3.count">
                  {t['loop.stage.3.count']}
                </span>
              </div>
              <div class="space-y-1">
                {skillsLoop.filter(s => s.stage === 3).map((s) => (
                  <button
                    type="button"
                    role="tab"
                    id={`tab-${s.id}`}
                    aria-selected="false"
                    aria-controls="pipeline-inspector-panel"
                    tabindex="-1"
                    data-skill-id={s.id}
                    class="pipeline-skill-tab group relative flex w-full items-center justify-between rounded-lg border border-transparent px-2.5 py-1.5 text-left transition-all duration-150 hover:bg-[rgb(var(--bg-surface-elevated))] active:scale-[0.99] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[rgb(var(--focus))]"
                  >
                    <div class="flex items-center gap-2 min-w-0">
                      <span class="font-mono text-[10.5px] font-semibold text-[rgb(var(--text-tertiary))] group-hover:text-[rgb(var(--text-primary))]">
                        {s.number}
                      </span>
                      <span class="shrink-0 font-mono text-[12px] font-medium text-[rgb(var(--text-primary))]">
                        {s.command}
                      </span>
                      <span class="hidden 2xl:inline-block truncate text-[10.5px] text-[rgb(var(--text-secondary))] max-w-[120px]">
                        · <span data-i18n={`loop.skill.${s.id}.short`}>{t[`loop.skill.${s.id}.short`]}</span>
                      </span>
                    </div>
                    <div class="flex items-center gap-1.5 shrink-0 ml-1.5">
                      {s.badge && (
                        <span class={`rounded px-1.5 py-0.5 font-mono text-[8.5px] font-semibold ${s.badge.variant === 'success' ? 'bg-emerald-500/15 border border-emerald-600/40 text-emerald-900 dark:text-emerald-300' : 'bg-[rgb(var(--bg-surface-elevated))] border border-[rgb(var(--border-rgb)/0.12)] text-[rgb(var(--text-secondary))]'}`}>
                          <span data-locale="es">{s.badge.es}</span>
                          <span data-locale="en" hidden>{s.badge.en}</span>
                        </span>
                      )}
                      <span class="font-mono text-[9px] text-[rgb(var(--text-secondary))]">
                        {s.size}
                      </span>
                    </div>
                  </button>
                ))}
              </div>
            </div>

          </div>

          <!-- COLUMNA DETAIL (Derecha, 7 cols): Inspector de Directivas en Tiempo Real -->
          <div id="pipeline-inspector-panel" role="tabpanel" aria-labelledby="tab-specify" class="md:col-span-7 flex flex-col justify-between bg-[rgb(var(--bg-surface-elevated))] p-5 sm:p-6 min-h-[380px] md:min-h-[420px]">
            
            <!-- Cabecera de la Consola del Inspector -->
            <div>
              <div class="flex flex-wrap items-center justify-between gap-2 border-b border-[rgb(var(--border-rgb)/0.1)] pb-3.5">
                <div class="flex items-center gap-2">
                  <span class="rounded bg-neutral-900 px-2.5 py-1 font-mono text-[12.5px] font-bold text-white dark:bg-white dark:text-neutral-900" id="inspector-command">
                    /omni-specify
                  </span>
                  <span class="font-mono text-[11px] text-[rgb(var(--text-tertiary))]" id="inspector-size">
                    8.2 KB
                  </span>
                  <span class="rounded bg-[rgb(var(--bg-base))] border border-[rgb(var(--border-rgb)/0.12)] px-2 py-0.5 font-mono text-[10px] text-[rgb(var(--text-secondary))]" id="inspector-stage-badge">
                    ETAPA 01 · ONBOARDING & ALCANCE
                  </span>
                </div>
                <span class="font-mono text-[10px] uppercase tracking-wider text-[rgb(var(--text-tertiary))]" data-i18n="loop.inspector.title">
                  {t['loop.inspector.title']}
                </span>
              </div>

              <!-- Misión -->
              <div class="mt-4">
                <span class="block font-mono text-[10px] font-bold uppercase tracking-wider text-[rgb(var(--text-tertiary))]" data-i18n="loop.inspector.mission">
                  {t['loop.inspector.mission']}
                </span>
                <p class="mt-1.5 text-[13.5px] font-medium leading-relaxed text-[rgb(var(--text-primary))]" id="inspector-mission">
                  Formalizar una solicitud en un tipo de trabajo (feature, bugfix, debt o rfc).
                </p>
              </div>

              <!-- Directiva / Prohibición estricta -->
              <div class="mt-4">
                <span class="block font-mono text-[10px] font-bold uppercase tracking-wider text-[rgb(var(--text-tertiary))]" data-i18n="loop.inspector.instruction">
                  {t['loop.inspector.instruction']}
                </span>
                <div class="mt-1.5 rounded-xl border border-[rgb(var(--border-rgb)/0.12)] bg-[rgb(var(--bg-base))] p-4 font-mono text-[12px] leading-relaxed text-[rgb(var(--text-primary))] shadow-inner">
                  <span class="select-none text-[rgb(var(--accent))]">"</span><span id="inspector-instruction">Evalúa el triaje ceremonial (omni-spec fit). Redacta criterios de aceptación obligatorios bajo sintaxis formal EARS (AC-01 [functional]). Define explícitamente lo que está FUERA de alcance (Non-Goals) para evitar desviaciones.</span><span class="select-none text-[rgb(var(--accent))]">"</span>
                </div>
              </div>
            </div>

            <!-- Footer técnico de la Consola -->
            <div class="mt-5 border-t border-[rgb(var(--border-rgb)/0.12)] pt-3 flex items-center justify-between font-mono text-[10.5px] text-[rgb(var(--text-secondary))]">
              <span class="flex items-center gap-1.5">
                <span class="h-1.5 w-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span>
                <span data-locale="es">FAIL-FAST Y CERO CODE SLOP</span>
                <span data-locale="en" hidden>FAIL-FAST &amp; ZERO CODE SLOP</span>
              </span>
              <span id="inspector-evidence-status" class="text-[rgb(var(--text-primary))] font-medium">
                <span data-locale="es">PIPELINE DETERMINISTA</span>
                <span data-locale="en" hidden>DETERMINISTIC PIPELINE</span>
              </span>
            </div>

          </div>

        </div>

      </div>

      <!-- Enlace sutil y limpio a Documentación -->
      <div class="mt-4 flex items-center justify-center">
        <a 
          href={base + '/docs/'} 
          class="inline-flex items-center gap-1.5 text-[12px] font-medium text-[rgb(var(--text-secondary))] transition-colors duration-150 hover:text-[rgb(var(--text-primary))] hover:underline" 
          data-i18n="loop.docsLink"
        >
          {t['loop.docsLink']}
        </a>
      </div>

    </div>

  </div>
</section>

<!-- Script Reactivo del Workbench Master-Detail con Navegación de Teclado WAI-ARIA -->
<script>
  import { skillsLoop, stages } from '../data/skills-loop';
  import { getLanguage } from '../scripts/preferences';

  const container = document.getElementById('skills-pipeline-diagram');
  if (container) {
    const tabs = Array.from(container.querySelectorAll<HTMLButtonElement>('.pipeline-skill-tab'));
    const panel = document.getElementById('pipeline-inspector-panel');
    const cmdEl = document.getElementById('inspector-command');
    const sizeEl = document.getElementById('inspector-size');
    const stageBadgeEl = document.getElementById('inspector-stage-badge');
    const missionEl = document.getElementById('inspector-mission');
    const instructionEl = document.getElementById('inspector-instruction');
    const evidenceStatusEl = document.getElementById('inspector-evidence-status');

    let currentSkillId = 'specify';

    const updateInspector = (skillId: string, focusButton = false) => {
      currentSkillId = skillId;
      const skill = skillsLoop.find(s => s.id === skillId);
      if (!skill) return;

      const lang = getLanguage();
      const stageInfo = stages[skill.stage];
      const stagePrefix = lang === 'es' ? 'ETAPA' : 'STAGE';
      const stageTitle = stageInfo.title[lang] || stageInfo.title.es;

      if (cmdEl) cmdEl.textContent = skill.command;
      if (sizeEl) sizeEl.textContent = skill.size;
      if (stageBadgeEl) stageBadgeEl.textContent = `${stagePrefix} ${stageInfo.number} · ${stageTitle.toUpperCase()}`;
      if (missionEl) missionEl.textContent = skill.mission[lang] || skill.mission.es;
      if (instructionEl) instructionEl.textContent = skill.instruction[lang] || skill.instruction.es;
      if (panel) panel.setAttribute('aria-labelledby', `tab-${skill.id}`);

      if (evidenceStatusEl) {
        if (skill.id === 'converge') {
          evidenceStatusEl.textContent = lang === 'es' ? '✓ EXIT CODE 0 · COMPROBADO' : '✓ EXIT CODE 0 · VERIFIED';
          evidenceStatusEl.className = 'text-emerald-600 dark:text-emerald-400 font-semibold';
        } else if (skill.id === 'audit') {
          evidenceStatusEl.textContent = 'QUALITY GATE · STRICT PASS';
          evidenceStatusEl.className = 'text-amber-600 dark:text-amber-400 font-semibold';
        } else {
          evidenceStatusEl.textContent = lang === 'es' ? 'PIPELINE DETERMINISTA' : 'DETERMINISTIC PIPELINE';
          evidenceStatusEl.className = 'text-[rgb(var(--text-secondary))] font-medium';
        }
      }

      tabs.forEach(btn => {
        const isSelected = btn.dataset.skillId === skillId;
        btn.setAttribute('aria-selected', isSelected ? 'true' : 'false');
        btn.setAttribute('tabindex', isSelected ? '0' : '-1');

        if (isSelected) {
          btn.classList.add(
            'border-[rgb(var(--border-rgb)/0.25)]',
            'bg-[rgb(var(--bg-surface-elevated))]',
            'shadow-sm',
            'font-semibold'
          );
          btn.classList.remove('border-transparent');
          if (focusButton) btn.focus();
        } else {
          btn.classList.remove(
            'border-[rgb(var(--border-rgb)/0.25)]',
            'bg-[rgb(var(--bg-surface-elevated))]',
            'shadow-sm',
            'font-semibold'
          );
          btn.classList.add('border-transparent');
        }
      });

      // Si estamos en mobile y el usuario interactuó explícitamente, asegurar que el inspector esté visible sin saltos bruscos
      if (focusButton && window.innerWidth < 768 && panel) {
        panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    };

    // Click handler
    tabs.forEach(btn => {
      btn.addEventListener('click', () => {
        const skillId = btn.dataset.skillId;
        if (skillId) updateInspector(skillId, true);
      });
    });

    // Keyboard navigation (Arrow keys, Home, End)
    container.addEventListener('keydown', (e) => {
      const activeElement = document.activeElement as HTMLButtonElement | null;
      if (!activeElement || !tabs.includes(activeElement)) return;

      const currentIndex = tabs.indexOf(activeElement);
      let targetIndex = -1;

      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
        e.preventDefault();
        targetIndex = (currentIndex + 1) % tabs.length;
      } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
        e.preventDefault();
        targetIndex = (currentIndex - 1 + tabs.length) % tabs.length;
      } else if (e.key === 'Home') {
        e.preventDefault();
        targetIndex = 0;
      } else if (e.key === 'End') {
        e.preventDefault();
        targetIndex = tabs.length - 1;
      }

      if (targetIndex >= 0) {
        const targetBtn = tabs[targetIndex];
        const skillId = targetBtn.dataset.skillId;
        if (skillId) updateInspector(skillId, true);
      }
    });

    // Escucha de cambio de idioma global (ES <-> EN)
    window.addEventListener('omni:language-change', () => {
      updateInspector(currentSkillId, false);
    });

    // Default selection
    updateInspector('specify', false);
  }
</script>
