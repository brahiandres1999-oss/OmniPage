---
import { translations } from '../i18n/translations';
import ArtifactIllustration from './ArtifactIllustration.astro';
import Icon from './Icon.astro';
const t = translations.es;
const files = ['project-context.md', 'spec.md', 'verification.json'];
---
<section id="caos-vs-spec" class="section-space">
  <div class="page-shell">
    <div class="section-intro two-column-intro">
      <div><p class="eyebrow" data-i18n="value.eyebrow">{t['value.eyebrow']}</p><h2 class="section-title" data-i18n="value.title">{t['value.title']}</h2></div>
      <p class="body-copy" data-i18n="value.intro">{t['value.intro']}</p>
    </div>
    <div class="value-grid">
      {[1,2,3].map((item, index) => <article class="value-item">
        <ArtifactIllustration kind={(['context','scope','evidence'] as const)[index]} />
        <h3 data-i18n={'value.' + item + '.title'}>{t['value.' + item + '.title']}</h3>
        <p class="body-copy" data-i18n={'value.' + item + '.body'}>{t['value.' + item + '.body']}</p>
        <div class="artifact-label"><Icon name={['message','file','checklist'][index]} /><div><code>{files[index]}</code><span data-i18n={'value.' + item + '.file'}>{t['value.' + item + '.file']}</span></div></div>
      </article>)}
    </div>
  </div>
</section>
