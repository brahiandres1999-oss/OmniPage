---
interface Props {
  command?: string;
  prefix?: string;
}

const {
  command = "npx --yes omni-spec@latest init --yes --agent antigravity",
  prefix = "$"
} = Astro.props;
---

<div class="relative flex items-center justify-between w-full max-w-2xl px-4 py-3 rounded-xl bg-surface border border-border transition-all shadow-xl group">
  <!-- Snippet de comando -->
  <div class="flex items-center gap-3 overflow-x-auto no-scrollbar font-mono text-xs sm:text-sm text-left pr-3">
    <span class="text-accent font-semibold select-none">{prefix}</span>
    <span class="text-primary whitespace-nowrap" id="cmd-text">{command}</span>
  </div>

  <!-- Botón de copiado con microinteracción -->
  <button
    type="button"
    class="copy-btn shrink-0 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-mono font-medium bg-surface-elevated hover:bg-surface-hover text-primary-muted hover:text-primary border border-border transition-all active:scale-95 focus:outline-none focus:ring-2 focus:ring-accent"
    data-copy={command}
    aria-label="Copiar comando al portapapeles"
    data-i18n-aria="copy.aria"
  >
    <!-- Icono Copiar (Default) -->
    <svg class="copy-icon w-3.5 h-3.5 text-primary-muted transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
    </svg>
    <!-- Icono Check (Éxito) -->
    <svg class="check-icon w-3.5 h-3.5 text-emerald-500 dark:text-emerald-400 hidden transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
    </svg>
    <span class="copy-label" data-i18n="copy.copy">Copiar</span>
  </button>
</div>

<script>
  function setupCopyButtons() {
    const buttons = document.querySelectorAll('.copy-btn');
    buttons.forEach((btn) => {
      btn.addEventListener('click', async () => {
        const textToCopy = btn.getAttribute('data-copy');
        if (!textToCopy) return;

        try {
          await navigator.clipboard.writeText(textToCopy);
          const copyIcon = btn.querySelector('.copy-icon');
          const checkIcon = btn.querySelector('.check-icon');
          const label = btn.querySelector('.copy-label');

          if (copyIcon && checkIcon && label) {
            const currentLang = (localStorage.getItem('omni-lang') as 'es' | 'en') || 'es';
            copyIcon.classList.add('hidden');
            checkIcon.classList.remove('hidden');
            label.textContent = currentLang === 'en' ? 'Copied!' : '¡Copiado!';
            btn.classList.add('border-emerald-500/40', 'bg-emerald-500/10');

            setTimeout(() => {
              const activeLang = (localStorage.getItem('omni-lang') as 'es' | 'en') || 'es';
              copyIcon.classList.remove('hidden');
              checkIcon.classList.add('hidden');
              label.textContent = activeLang === 'en' ? 'Copy' : 'Copiar';
              btn.classList.remove('border-emerald-500/40', 'bg-emerald-500/10');
            }, 2000);
          }
        } catch (err) {
          console.error('Error al copiar:', err);
        }
      });
    });
  }

  setupCopyButtons();
  document.addEventListener('astro:page-load', setupCopyButtons);
</script>
