---

<!-- Botón Flotante Volver Arriba con Indicador de Scroll -->
<button
  type="button"
  id="back-to-top-btn"
  class="fixed bottom-6 right-6 z-40 w-11 h-11 rounded-xl bg-surface/85 hover:bg-surface-elevated border border-border hover:border-accent text-primary-muted hover:text-primary shadow-sm backdrop-blur-md opacity-0 motion-safe:translate-y-4 motion-safe:scale-90 pointer-events-none transition-[opacity,transform,background-color,border-color] duration-300 ease-out flex items-center justify-center group enabled:active:scale-[0.96] focus:outline-none focus-visible:ring-2 focus-visible:ring-accent cursor-pointer [-webkit-tap-highlight-color:transparent]"
  aria-label="Volver al inicio de la página"
  title="Volver arriba"
  data-i18n-aria="footer.backToTop"
  data-i18n-title="footer.backToTop"
>
  <!-- Anillo SVG de progreso de scroll sutil -->
  <svg class="absolute inset-0 w-full h-full -rotate-90 pointer-events-none" viewBox="0 0 44 44">
    <circle
      cx="22"
      cy="22"
      r="18"
      stroke="currentColor"
      stroke-width="1.8"
      fill="none"
      class="text-border/40"
    />
    <circle
      id="scroll-progress-circle"
      cx="22"
      cy="22"
      r="18"
      stroke="currentColor"
      stroke-width="2"
      fill="none"
      stroke-dasharray="113.1"
      stroke-dashoffset="113.1"
      stroke-linecap="round"
      class="text-accent transition-[stroke-dashoffset] duration-75"
    />
  </svg>

  <!-- Icono Flecha hacia arriba -->
  <svg 
    class="w-4 h-4 motion-safe:transition-transform duration-200 motion-safe:group-hover:-translate-y-0.5" 
    fill="none" 
    stroke="currentColor" 
    stroke-width="2" 
    viewBox="0 0 24 24"
  >
    <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7" />
  </svg>
</button>

<script>
  function setupBackToTop() {
    const btn = document.getElementById('back-to-top-btn');
    const circle = document.getElementById('scroll-progress-circle');
    if (!btn || !circle || btn.dataset.bound === 'true') return;
    btn.dataset.bound = 'true';

    const circumference = 2 * Math.PI * 18; // ~113.1

    const handleScroll = () => {
      const scrollTop = window.scrollY || document.documentElement.scrollTop;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const scrollPercent = docHeight > 0 ? (scrollTop / docHeight) : 0;

      // Actualizar anillo de progreso
      const offset = circumference - (scrollPercent * circumference);
      circle.style.strokeDashoffset = String(offset);

      // Activar botón solo cuando se supera el 15% de scroll o más de 300px
      if (scrollPercent > 0.15 || scrollTop > 350) {
        btn.classList.remove('opacity-0', 'motion-safe:translate-y-4', 'motion-safe:scale-90', 'pointer-events-none');
        btn.classList.add('opacity-100', 'motion-safe:translate-y-0', 'motion-safe:scale-100', 'pointer-events-auto');
      } else {
        btn.classList.add('opacity-0', 'motion-safe:translate-y-4', 'motion-safe:scale-90', 'pointer-events-none');
        btn.classList.remove('opacity-100', 'motion-safe:translate-y-0', 'motion-safe:scale-100', 'pointer-events-auto');
      }
    };

    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();

    btn.addEventListener('click', () => {
      window.scrollTo({
        top: 0,
        behavior: 'smooth'
      });
    });
  }

  setupBackToTop();
  document.addEventListener('astro:page-load', setupBackToTop);
</script>
