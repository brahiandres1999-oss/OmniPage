---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import CopySnippet from '../../components/CopySnippet.astro';

interface DocNavItem {
  id: string;
  title: string;
}

interface DocNavCategory {
  category: string;
  items: DocNavItem[];
}

const docNavByLang: Record<'es' | 'en', DocNavCategory[]> = {
  es: [
    {
      category: "Primeros Pasos",
      items: [
        { id: "intro", title: "Introducción a SDD" },
        { id: "instalacion", title: "Instalación y Requisitos" },
        { id: "quickstart", title: "Guía de Inicio Rápido" },
      ]
    },
    {
      category: "Gobernanza & Invariantes",
      items: [
        { id: "constitucion", title: "CONSTITUTION.md" },
        { id: "anti-slop", title: "Invariantes Anti-Slop" },
        { id: "estructura", title: "Estructura en Disco (specs/)" },
        { id: "arquetipos", title: "Los 4 Arquetipos de Trabajo" },
        { id: "manifest-lock", title: "Manifiesto y Concurrencia" },
      ]
    },
    {
      category: "Suite de 9 Flujos de Trabajo",
      items: [
        { id: "flujo-descubrimiento", title: "Fase 1: Descubrimiento" },
        { id: "flujo-contratos", title: "Fase 2: Contratos Técnicos" },
        { id: "flujo-ejecucion", title: "Fase 3: Ejecución y Cierre" },
      ]
    },
    {
      category: "Perfiles de Dominio",
      items: [
        { id: "perfiles-intro", title: "Invariantes vs OpenSpec" },
        { id: "perfiles-catalogo", title: "Catálogo de Perfiles" },
      ]
    },
    {
      category: "Agentes Soportados",
      items: [
        { id: "adaptadores-agentes", title: "Adaptadores Multi-Agente" },
        { id: "quality-gates", title: "Quality Gates con Exit Code 0" },
      ]
    }
  ],
  en: [
    {
      category: "Getting Started",
      items: [
        { id: "intro", title: "Introduction to SDD" },
        { id: "instalacion", title: "Installation & Requirements" },
        { id: "quickstart", title: "Quickstart Guide" },
      ]
    },
    {
      category: "Governance & Invariants",
      items: [
        { id: "constitucion", title: "CONSTITUTION.md" },
        { id: "anti-slop", title: "Anti-Slop Invariants" },
        { id: "estructura", title: "Disk Structure (specs/)" },
        { id: "arquetipos", title: "The 4 Work Archetypes" },
        { id: "manifest-lock", title: "Manifest & Concurrency" },
      ]
    },
    {
      category: "9-Workflow Suite",
      items: [
        { id: "flujo-descubrimiento", title: "Phase 1: Discovery" },
        { id: "flujo-contratos", title: "Phase 2: Technical Contracts" },
        { id: "flujo-ejecucion", title: "Phase 3: Execution & Closure" },
      ]
    },
    {
      category: "Domain Profiles",
      items: [
        { id: "perfiles-intro", title: "Invariants vs OpenSpec" },
        { id: "perfiles-catalogo", title: "Profile Catalog" },
      ]
    },
    {
      category: "Supported Agents",
      items: [
        { id: "adaptadores-agentes", title: "Multi-Agent Adapters" },
        { id: "quality-gates", title: "Quality Gates with Exit Code 0" },
      ]
    }
  ]
};

const initialDocNav = docNavByLang.es;
---

<Layout 
  title="Documentación Oficial — OmniSpec"
  description="Guía completa de arquitectura, comandos CLI, especificaciones en disco y perfiles de gobernanza de OmniSpec."
>
  <Navbar />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Barra Lateral de Documentación (Desktop Sticky con Scroll Spy) -->
      <aside class="hidden lg:block lg:col-span-3 sticky top-24 self-start max-h-[calc(100vh-7rem)] overflow-y-auto pr-4 font-mono text-xs border-r border-border space-y-6">
        <div class="pb-2 border-b border-border flex items-center justify-between">
          <span id="docs-sidebar-title" class="font-bold text-primary text-sm font-sans tracking-tight">Documentación</span>
        </div>

        <nav id="docs-sidebar-nav" aria-label="Navegación de documentación" class="space-y-6">
          {initialDocNav.map((sec) => (
            <div class="space-y-2">
              <h3 class="font-bold text-primary-muted uppercase text-[10px] tracking-wider">
                {sec.category}
              </h3>
              <ul class="space-y-1">
                {sec.items.map((item) => (
                  <li>
                    <a 
                      href={`#${item.id}`} 
                      class="docs-nav-link block py-1 px-2 rounded text-primary-muted hover:text-primary hover:bg-surface border-l-2 border-transparent transition-all"
                      data-section={item.id}
                    >
                      {item.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </nav>
      </aside>

      <!-- Contenido Principal de Documentación (9 Columnas) -->
      <article class="lg:col-span-9 space-y-16 max-w-3xl leading-relaxed text-sm sm:text-base text-primary-muted">
        
        <!-- Header de Docs -->
        <header class="border-b border-border pb-8">
          <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded bg-surface-elevated border border-border text-xs font-mono text-accent mb-4">
            <span data-i18n="docs.badge">Guía Técnica del Framework</span>
          </div>
          <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-primary tracking-tight font-sans" data-i18n="docs.title">
            Documentación de OmniSpec
          </h1>
          <p class="mt-4 text-base sm:text-lg text-primary-muted leading-relaxed" data-i18n="docs.subtitle">
            OmniSpec traslada el desarrollo con agentes desde el "vibe coding" no determinista hacia la ingeniería guiada por especificaciones verificables en Git.
          </p>
        </header>

        <!-- SECCIÓN 1: Introducción -->
        <section id="intro" class="scroll-mt-24">
          <!-- ES -->
          <div data-docs-lang="es" class="space-y-4">
            <h2 class="text-2xl font-bold text-primary font-sans">1. Introducción a Spec-Driven Development (SDD)</h2>
            <p>
              Cuando interactúas con un agente de código únicamente mediante la ventana de chat, el modelo tiende a cometer dos errores críticos conforme la conversación se alarga: <strong>olvida restricciones arquitectónicas previas</strong> y <strong>reescribe código funcional ajeno al objetivo</strong>.
            </p>
            <p>
              Spec-Driven Development invierte esta dinámica: antes de escribir código en producción, el agente formaliza el contrato en archivos Markdown en tu disco local. Este contrato delimita los archivos a tocar, define criterios de aceptación (AC) y obliga a comprobar cada cambio mediante los tests reales de tu repositorio.
            </p>
          </div>
          <!-- EN -->
          <div data-docs-lang="en" class="space-y-4 hidden">
            <h2 class="text-2xl font-bold text-primary font-sans">1. Introduction to Spec-Driven Development (SDD)</h2>
            <p>
              When interacting with a coding agent solely through a chat window, the model tends to make two critical mistakes as conversation depth grows: <strong>it forgets prior architectural constraints</strong> and <strong>rewrites functional code unrelated to the task</strong>.
            </p>
            <p>
              Spec-Driven Development reverses this dynamic: prior to mutating production files, the agent formalizes a contract in local Markdown specifications on disk. This contract establishes strict file boundary scopes, defines verifiable acceptance criteria (AC), and mandates verification against your repository's real test suite.
            </p>
          </div>
        </section>

        <!-- SECCIÓN 2: Instalación -->
        <section id="instalacion" class="scroll-mt-24">
          <!-- ES -->
          <div data-docs-lang="es" class="space-y-4">
            <h2 class="text-2xl font-bold text-primary font-sans">2. Instalación y Requisitos del Entorno</h2>
            <p>
              OmniSpec opera como un ejecutable autónomo local con <strong>cero dependencias de producción</strong>. Solo requiere Node.js 18.19.0 o superior en tu máquina:
            </p>
            <div class="my-4">
              <CopySnippet command="npx --yes omni-spec@latest init" />
            </div>
            <p class="text-xs font-mono text-primary-muted">
              Al ejecutar el comando, OmniSpec inspecciona las herramientas y archivos de tu repositorio de forma no destructiva e inicializa el runtime bajo <code class="text-primary font-mono">specs/.omni/runtime/</code>.
            </p>
          </div>
          <!-- EN -->
          <div data-docs-lang="en" class="space-y-4 hidden">
            <h2 class="text-2xl font-bold text-primary font-sans">2. Installation & Environment Requirements</h2>
            <p>
              OmniSpec operates as a self-contained local executable with <strong>zero production dependencies</strong>. It only requires Node.js 18.19.0 or higher on your machine:
            </p>
            <div class="my-4">
              <CopySnippet command="npx --yes omni-spec@latest init" />
            </div>
            <p class="text-xs font-mono text-primary-muted">
              Upon execution, OmniSpec inspects your repository tooling non-destructively and scaffolds the runtime under <code class="text-primary font-mono">specs/.omni/runtime/</code>.
            </p>
          </div>
        </section>

        <!-- SECCIÓN 2.1: Quickstart -->
        <section id="quickstart" class="scroll-mt-24">
          <!-- ES -->
          <div data-docs-lang="es" class="space-y-4">
            <h2 class="text-2xl font-bold text-primary font-sans">2.1 Guía de Inicio Rápido</h2>
            <p>
              Para inicializar un nuevo proyecto con un perfil de industria específico y adaptador para tu asistente preferido:
            </p>
            <div class="my-3">
              <CopySnippet command="npx omni-spec init --profile fintech --agent opencode" />
            </div>
            <p class="text-xs text-primary-muted">
              Esto compilará los comandos en <code class="text-primary font-mono">.opencode/commands/</code> e inyectará las invariantes financieras en <code class="text-primary font-mono">CONSTITUTION.md</code> de manera inmediata.
            </p>
          </div>
          <!-- EN -->
          <div data-docs-lang="en" class="space-y-4 hidden">
            <h2 class="text-2xl font-bold text-primary font-sans">2.1 Quickstart Guide</h2>
            <p>
              To initialize a project with an industry-specific profile and an adapter for your preferred coding agent:
            </p>
            <div class="my-3">
              <CopySnippet command="npx omni-spec init --profile fintech --agent opencode" />
            </div>
            <p class="text-xs text-primary-muted">
              This compiles the commands into <code class="text-primary font-mono">.opencode/commands/</code> and injects financial governance invariants into <code class="text-primary font-mono">CONSTITUTION.md</code> immediately.
            </p>
          </div>
        </section>

        <!-- SECCIÓN 3: CONSTITUTION.md -->
        <section id="constitucion" class="scroll-mt-24">
          <!-- ES -->
          <div data-docs-lang="es" class="space-y-4">
            <h2 class="text-2xl font-bold text-primary font-sans">3. CONSTITUTION.md: Gobernanza Inmutable</h2>
            <p>
              En la raíz del proyecto reside <code class="text-primary font-mono font-semibold">CONSTITUTION.md</code>. Esta constitución contiene las 4 leyes inmutables que cualquier agente compatible debe consultar y acatar de manera obligatoria:
            </p>
            <div class="grid grid-cols-1 gap-4 font-mono text-xs">
              <div class="p-4 rounded-lg bg-surface border border-border space-y-1">
                <span class="text-accent font-bold">Ley 01: Diagnóstico Pre-Ejecución</span>
                <p class="text-primary-muted">Prohibido escribir código sin antes emitir un reporte con: Problema, Solución y Riesgos. Si algo es ambiguo, el agente debe detenerse y preguntar.</p>
              </div>
              <div class="p-4 rounded-lg bg-surface border border-border space-y-1">
                <span class="text-emerald-500 font-bold">Ley 02: Alcance Mínimo Estricto</span>
                <p class="text-primary-muted">Modificar exclusivamente los archivos planificados. Queda vetado el formateo masivo de archivos ajenos o la introducción de soluciones provisionales.</p>
              </div>
              <div class="p-4 rounded-lg bg-surface border border-border space-y-1">
                <span class="text-amber-500 font-bold">Ley 03: Verificación con Comandos Reales</span>
                <p class="text-primary-muted">La confirmación verbal del modelo no tiene valor de ingeniería. Cada cambio debe verificarse con comandos reales del repositorio con exit code 0.</p>
              </div>
              <div class="p-4 rounded-lg bg-surface border border-border space-y-1">
                <span class="text-cyan-500 font-bold">Ley 04: Ergonomía y Estados de Interfaz</span>
                <p class="text-primary-muted">En componentes de interfaz se exige contemplar los 4 estados canónicos: Carga, Vacío, Error y Éxito, con accesibilidad probada.</p>
              </div>
            </div>
          </div>
          <!-- EN -->
          <div data-docs-lang="en" class="space-y-4 hidden">
            <h2 class="text-2xl font-bold text-primary font-sans">3. CONSTITUTION.md: Immutable Governance</h2>
            <p>
              At the root of the project resides <code class="text-primary font-mono font-semibold">CONSTITUTION.md</code>. This constitution defines the 4 immutable laws that every compatible agent is strictly obligated to inspect and obey:
            </p>
            <div class="grid grid-cols-1 gap-4 font-mono text-xs">
              <div class="p-4 rounded-lg bg-surface border border-border space-y-1">
                <span class="text-accent font-bold">Law 01: Pre-Execution Diagnosis</span>
                <p class="text-primary-muted">Writing code without first outputting a report with: Problem, Proposed Solution, and Risks is prohibited. If requirements are ambiguous, the agent must pause and ask.</p>
              </div>
              <div class="p-4 rounded-lg bg-surface border border-border space-y-1">
                <span class="text-emerald-500 font-bold">Law 02: Strict Scoped Surgery</span>
                <p class="text-primary-muted">Modify exclusively the planned files. Blanket reformatting of unapproved files and temporary hacks are strictly forbidden.</p>
              </div>
              <div class="p-4 rounded-lg bg-surface border border-border space-y-1">
                <span class="text-amber-500 font-bold">Law 03: Real Command Verification</span>
                <p class="text-primary-muted">Verbal confirmation from the model holds zero engineering validity. Every change must be verified using real repository commands with exit code 0.</p>
              </div>
              <div class="p-4 rounded-lg bg-surface border border-border space-y-1">
                <span class="text-cyan-500 font-bold">Law 04: Interface Ergonomics & States</span>
                <p class="text-primary-muted">UI components must explicitly handle the 4 canonical states: Loading, Empty, Error, and Success, with verified accessibility.</p>
              </div>
            </div>
          </div>
        </section>

        <!-- SECCIÓN 3.1: Invariantes Anti-Slop (UI & Backend) -->
        <section id="anti-slop" class="scroll-mt-24">
          <!-- ES -->
          <div data-docs-lang="es" class="space-y-4">
            <h2 class="text-2xl font-bold text-primary font-sans">3.1 Invariantes Anti-Slop en Frontend y Backend</h2>
            <p>
              Los agentes de IA tienden por defecto a generar "AI Slop": código defensivo excesivo, trampas silenciosas de errores, comentarios obvios de relleno y clichés visuales genéricos. OmniSpec combate esta degradación inyectando invariantes deterministas en el Core:
            </p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs font-mono">
              <div class="p-4 rounded-lg bg-surface border border-border space-y-2">
                <span class="text-accent font-bold block text-sm">Frontend Craft Impecable</span>
                <ul class="space-y-1.5 text-primary-muted list-disc list-inside">
                  <li><strong>4 Estados de UI:</strong> Exigencia de estado de carga (skeleton), error explícito, vacío ilustrativo y éxito interactivo.</li>
                  <li><strong>Cero Clichés de IA:</strong> Prohibidos degradados violeta/cian genéricos, sombras borrosas flotantes o "card-itis" anidado.</li>
                  <li><strong>Accesibilidad WCAG AA:</strong> Contraste de color medido, navegación por teclado y etiquetas aria descriptivas.</li>
                  <li><strong>Micro-interacciones:</strong> Feedback visual táctil e instantáneo en botones y controles.</li>
                </ul>
              </div>
              <div class="p-4 rounded-lg bg-surface border border-border space-y-2">
                <span class="text-emerald-500 font-bold block text-sm">Backend Pragmático & YAGNI</span>
                <ul class="space-y-1.5 text-primary-muted list-disc list-inside">
                  <li><strong>YAGNI Estricto:</strong> Rechazo a fábricas abstractas, interfaces prematuras y patrones de diseño innecesarios.</li>
                  <li><strong>Cero Comentarios Basura:</strong> Prohibido el "comment slop" que parafrasea lo evidente (ej. <code class="text-primary font-mono">// increments i</code>).</li>
                  <li><strong>Fail-Fast Obligatorio:</strong> Prohibido silenciar excepciones con <code class="text-primary font-mono">try/catch</code> vacíos o devolver valores nulos que oculten causas raíz.</li>
                  <li><strong>Contratos de Tipos:</strong> Estricta coherencia de firmas y validación en las fronteras de entrada/salida.</li>
                </ul>
              </div>
            </div>
          </div>
          <!-- EN -->
          <div data-docs-lang="en" class="space-y-4 hidden">
            <h2 class="text-2xl font-bold text-primary font-sans">3.1 Anti-Slop Invariants across Frontend & Backend</h2>
            <p>
              AI coding agents default to producing "AI Slop": excessive defensive abstractions, error swallowing, redundant parrot comments, and generic visual clichés. OmniSpec neutralizes this regression by embedding binding invariants into the Core:
            </p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs font-mono">
              <div class="p-4 rounded-lg bg-surface border border-border space-y-2">
                <span class="text-accent font-bold block text-sm">Impeccable Frontend Craft</span>
                <ul class="space-y-1.5 text-primary-muted list-disc list-inside">
                  <li><strong>4 UI States:</strong> Mandatory handling of loading (skeleton), explicit actionable error, clear empty state, and interactive success.</li>
                  <li><strong>Zero AI Clichés:</strong> Prohibited ungrounded purple/cyan gradients, floaty blurry shadows, and nested card-itis.</li>
                  <li><strong>WCAG AA Accessibility:</strong> Measured color contrast, complete keyboard navigability, and descriptive ARIA attributes.</li>
                  <li><strong>Micro-interactions:</strong> Instant tactile feedback on clickable interactive controls.</li>
                </ul>
              </div>
              <div class="p-4 rounded-lg bg-surface border border-border space-y-2">
                <span class="text-emerald-500 font-bold block text-sm">Pragmatic Backend & YAGNI</span>
                <ul class="space-y-1.5 text-primary-muted list-disc list-inside">
                  <li><strong>Strict YAGNI:</strong> Outright rejection of premature interface factories and speculative architectural overhead.</li>
                  <li><strong>Zero Comment Slop:</strong> Strict ban on trivial parrot comments that simply rephrase the code syntax.</li>
                  <li><strong>Mandatory Fail-Fast:</strong> Banned empty defensive <code class="text-primary font-mono">try/catch</code> blocks swallowing runtime failures.</li>
                  <li><strong>Strict Type Boundaries:</strong> Strict parameter signature enforcement and input/output schema validation.</li>
                </ul>
              </div>
            </div>
          </div>
        </section>

        <!-- SECCIÓN 4: Estructura specs/ -->
        <section id="estructura" class="scroll-mt-24">
          <!-- ES -->
          <div data-docs-lang="es" class="space-y-4">
            <h2 class="text-2xl font-bold text-primary font-sans">4. Estructura en Disco del Directorio specs/</h2>
            <p>
              Cada unidad de trabajo (feature, bugfix, refactor o RFC) tiene su propio espacio aislado dentro de <code class="text-primary font-mono">specs/</code>:
            </p>
            <div class="p-4 rounded-lg bg-surface dark:bg-[#0d0e12] border border-border font-mono text-xs text-primary-muted space-y-1.5 shadow-sm transition-colors">
              <div class="text-primary font-bold">specs/</div>
              <div class="pl-4">├── <span class="text-amber-600 dark:text-amber-400 font-bold">manifest.json</span> <span class="text-primary-muted/70"># Registro atómico de especificaciones y locks</span></div>
              <div class="pl-4">├── <span class="text-blue-600 dark:text-blue-400 font-bold">001-nombre-del-trabajo/</span></div>
              <div class="pl-8">├── <span class="text-emerald-600 dark:text-emerald-400">spec.md</span> <span class="text-primary-muted/70"># Criterios de aceptación (AC) y requerimientos</span></div>
              <div class="pl-8">├── <span class="text-emerald-600 dark:text-emerald-400">plan.md</span> <span class="text-primary-muted/70"># Arquitectura técnica y archivos a intervenir</span></div>
              <div class="pl-8">├── <span class="text-emerald-600 dark:text-emerald-400">tasks.md</span> <span class="text-primary-muted/70"># Tareas atómicas con comandos de prueba asociados</span></div>
              <div class="pl-8">└── <span class="text-emerald-600 dark:text-emerald-400">verification.md</span> <span class="text-primary-muted/70"># Evidencia de comandos y fingerprint SHA-256</span></div>
            </div>
          </div>
          <!-- EN -->
          <div data-docs-lang="en" class="space-y-4 hidden">
            <h2 class="text-2xl font-bold text-primary font-sans">4. On-Disk Structure of the specs/ Directory</h2>
            <p>
              Every unit of work (feature, bugfix, refactor, or RFC) maintains its own isolated workspace inside <code class="text-primary font-mono">specs/</code>:
            </p>
            <div class="p-4 rounded-lg bg-surface dark:bg-[#0d0e12] border border-border font-mono text-xs text-primary-muted space-y-1.5 shadow-sm transition-colors">
              <div class="text-primary font-bold">specs/</div>
              <div class="pl-4">├── <span class="text-amber-600 dark:text-amber-400 font-bold">manifest.json</span> <span class="text-primary-muted/70"># Atomic specification registry & lock tracker</span></div>
              <div class="pl-4">├── <span class="text-blue-600 dark:text-blue-400 font-bold">001-work-unit-name/</span></div>
              <div class="pl-8">├── <span class="text-emerald-600 dark:text-emerald-400">spec.md</span> <span class="text-primary-muted/70"># Acceptance criteria (AC) & scope definitions</span></div>
              <div class="pl-8">├── <span class="text-emerald-600 dark:text-emerald-400">plan.md</span> <span class="text-primary-muted/70"># Technical design & strict file boundaries</span></div>
              <div class="pl-8">├── <span class="text-emerald-600 dark:text-emerald-400">tasks.md</span> <span class="text-primary-muted/70"># Atomic tasks linked to Quality Gate commands</span></div>
              <div class="pl-8">└── <span class="text-emerald-600 dark:text-emerald-400">verification.md</span> <span class="text-primary-muted/70"># Command execution logs & SHA-256 fingerprint</span></div>
            </div>
          </div>
        </section>

        <!-- SECCIÓN 4.1: Los 4 Arquetipos de Trabajo -->
        <section id="arquetipos" class="scroll-mt-24">
          <!-- ES -->
          <div data-docs-lang="es" class="space-y-4">
            <h2 class="text-2xl font-bold text-primary font-sans">4.1 Los 4 Arquetipos de Trabajo de Ingeniería</h2>
            <p>
              OmniSpec no trata todas las tareas por igual. Ofrece 4 arquetipos especializados con plantillas de rigor diseñadas para cada naturaleza de cambio:
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs font-mono">
              <div class="p-3 rounded-lg bg-surface border border-border space-y-1">
                <span class="text-primary font-bold">01-feature (Nueva Funcionalidad)</span>
                <p class="text-primary-muted">Enfocado en Criterios de Aceptación (Gherkin), Fase 0 de aclaración, Non-Goals explícitos, contratos de datos y estrategia de rollback (down.sql).</p>
              </div>
              <div class="p-3 rounded-lg bg-surface border border-border space-y-1">
                <span class="text-primary font-bold">02-bugfix (Resolución de Bugs)</span>
