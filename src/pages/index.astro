---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import ProductCanvas from '../components/ProductCanvas.astro';
import ChaosVsSpec from '../components/ChaosVsSpec.astro';
import ConstitutionSection from '../components/ConstitutionSection.astro';
import DomainProfiles from '../components/DomainProfiles.astro';
import AgentSelector from '../components/AgentSelector.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="OmniSpec — Spec-Driven Development para Agentes de Código"
  description="Framework de desarrollo guiado por especificaciones con motor CLI local y gobernanza versionada en Git para agentes en Antigravity, OpenCode, Claude Code, Cursor y Codex."
>
  <Navbar />
  <main id="main-content" class="flex-1 flex flex-col">
    <Hero />
    <ProductCanvas />
    <ChaosVsSpec />
    <ConstitutionSection />
    <DomainProfiles />
    <AgentSelector />
    <FaqAccordion />
  </main>
  <Footer />
</Layout>
