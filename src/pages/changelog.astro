---

<Layout 
  title="Historial de Versiones (Changelog) — OmniSpec"
  description="Registro cronológico y detallado de versiones, nuevas funcionalidades, perfiles regulatorios y mejoras de arquitectura de OmniSpec."
>
  <Navbar />
  
  <main class="flex-1 py-16 md:py-24 transition-colors">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Encabezado de la Página -->
      <div class="mb-14 border-b border-border pb-8">
        <h1 class="text-4xl sm:text-5xl font-extrabold text-primary tracking-tight" data-i18n="changelog.pageTitle">
          Changelog
        </h1>
        <p class="mt-4 text-base sm:text-lg text-primary-muted leading-relaxed max-w-[65ch]" data-i18n="changelog.pageSubtitle">
          Todas las mejoras, directivas de gobernanza y actualizaciones del motor CLI de OmniSpec registradas cronológicamente con rigor de ingeniería.
        </p>
      </div>

      <!-- Timeline de Versiones -->
      <div id="changelog-timeline" class="space-y-16">
        {initialReleases.map((release) => (
          <article class="relative pl-6 sm:pl-8 border-l-2 border-border space-y-6">
            <!-- Marcador circular del timeline -->
            <div class="absolute -left-[9px] top-1 w-4 h-4 rounded-full bg-surface border-2 border-accent"></div>

            <!-- Cabecera de versión -->
            <div>
              <div class="flex flex-wrap items-center gap-3">
                <span class="text-xl font-bold font-mono text-primary">{release.version}</span>
                <span class={`text-[11px] font-mono px-2 py-0.5 rounded border ${
                  release.tag === 'Actual' || release.tag === 'Current'
                    ? 'bg-accent/10 border-accent/30 text-accent font-bold' 
                    : 'bg-surface-elevated border-border text-primary-muted'
                }`}>
                  {release.tag}
                </span>
                <span class="text-xs font-mono text-primary-muted">{release.date}</span>
              </div>
              <h2 class="text-2xl font-bold text-primary mt-2">
                {release.title}
              </h2>
              <p class="text-sm text-primary-muted mt-2 leading-relaxed">
                {release.description}
              </p>
            </div>

            <!-- Lista de Novedades y Cambios Técnicos -->
            <div class="space-y-3">
              {release.highlights.map((item) => (
                <div class="p-4 rounded-lg bg-surface border border-border flex flex-col gap-1.5 transition-colors">
                  <div class="flex items-center gap-2">
                    <span class={`text-[10px] font-mono font-bold uppercase px-1.5 py-0.5 rounded ${
                      item.type === 'feat' 
                        ? 'bg-emerald-500/10 text-emerald-500 dark:text-emerald-400 border border-emerald-500/30' 
                        : item.type === 'fix' 
                        ? 'bg-amber-500/10 text-amber-500 dark:text-amber-400 border border-amber-500/30'
                        : 'bg-blue-500/10 text-blue-500 dark:text-blue-400 border border-blue-500/30'
                    }`}>
                      {item.type}
                    </span>
                    <h3 class="text-sm font-semibold text-primary">{item.title}</h3>
                  </div>
                  <p class="text-xs sm:text-sm text-primary-muted leading-relaxed pl-1">
                    {item.detail}
                  </p>
                </div>
              ))}
            </div>

            <!-- Enlace directo a GitHub Release Tag -->
            <div class="pt-2">
              <a 
                href={`https://github.com/brahiandres1999-oss/omni-spec/releases/tag/${release.version}`}
                target="_blank" 
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-xs font-mono text-accent hover:underline"
              >
                <span class="release-github-text">Ver release en GitHub</span>
                <span>&rarr;</span>
              </a>
            </div>
          </article>
        ))}
      </div>

    </div>
  </main>

  <Footer />
</Layout>

<script define:vars={{ releasesByLang }}>
  function setupChangelogI18n() {
    const container = document.getElementById('changelog-timeline');
    if (!container) return;

    function renderReleases(lang) {
      const activeLang = lang === 'en' ? 'en' : 'es';
      const releases = releasesByLang[activeLang] || releasesByLang.es;
      const githubLabel = activeLang === 'en' ? 'View release on GitHub' : 'Ver release en GitHub';

      container.innerHTML = releases.map((release) => {
        const isCurrent = release.tag === 'Actual' || release.tag === 'Current';
        const tagClass = isCurrent
          ? 'bg-accent/10 border-accent/30 text-accent font-bold'
          : 'bg-surface-elevated border-border text-primary-muted';

        const highlightsHtml = release.highlights.map((item) => {
          const badgeClass = item.type === 'feat'
            ? 'bg-emerald-500/10 text-emerald-500 dark:text-emerald-400 border border-emerald-500/30'
            : item.type === 'fix'
            ? 'bg-amber-500/10 text-amber-500 dark:text-amber-400 border border-amber-500/30'
            : 'bg-blue-500/10 text-blue-500 dark:text-blue-400 border border-blue-500/30';

          return `
            <div class="p-4 rounded-lg bg-surface border border-border flex flex-col gap-1.5 transition-colors">
              <div class="flex items-center gap-2">
                <span class="text-[10px] font-mono font-bold uppercase px-1.5 py-0.5 rounded ${badgeClass}">
                  ${item.type}
                </span>
                <h3 class="text-sm font-semibold text-primary">${item.title}</h3>
              </div>
              <p class="text-xs sm:text-sm text-primary-muted leading-relaxed pl-1">
                ${item.detail}
              </p>
            </div>
          `;
        }).join('');

        return `
          <article class="relative pl-6 sm:pl-8 border-l-2 border-border space-y-6">
            <div class="absolute -left-[9px] top-1 w-4 h-4 rounded-full bg-surface border-2 border-accent"></div>
            <div>
              <div class="flex flex-wrap items-center gap-3">
                <span class="text-xl font-bold font-mono text-primary">${release.version}</span>
                <span class="text-[11px] font-mono px-2 py-0.5 rounded border ${tagClass}">
                  ${release.tag}
                </span>
                <span class="text-xs font-mono text-primary-muted">${release.date}</span>
              </div>
              <h2 class="text-2xl font-bold text-primary mt-2">
                ${release.title}
              </h2>
              <p class="text-sm text-primary-muted mt-2 leading-relaxed">
                ${release.description}
              </p>
            </div>
            <div class="space-y-3">
              ${highlightsHtml}
            </div>
            <div class="pt-2">
              <a 
                href="https://github.com/brahiandres1999-oss/omni-spec/releases/tag/${release.version}" 
                target="_blank" 
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-xs font-mono text-accent hover:underline"
              >
                <span>${githubLabel}</span>
                <span>&rarr;</span>
              </a>
            </div>
          </article>
        `;
      }).join('');
    }

    const currentLang = localStorage.getItem('omni-lang') || 'es';
    if (currentLang === 'en') {
      renderReleases('en');
    }

    window.addEventListener('omni:language-change', (e) => {
      renderReleases(e.detail.lang);
    });
  }

  setupChangelogI18n();
  document.addEventListener('astro:page-load', setupChangelogI18n);
</script>
