---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import releases from '../data/releases.json';
import { omniSpecRelease } from '../data/omnispec';
import { translations } from '../i18n/translations';
const t=translations.es;
const main=releases.filter(r=>r.version==='v'+omniSpecRelease.version||r.version==='v'+omniSpecRelease.stableVersion);
const history=releases.filter(r=>!main.includes(r));
const date=(value:string,lang:string)=>new Intl.DateTimeFormat(lang,{dateStyle:'long',timeZone:'UTC'}).format(new Date(value+'T12:00:00Z'));
---
<Layout title="Novedades — OmniSpec" titleEn="Releases — OmniSpec" description="Versiones publicadas de OmniSpec: canales preview y latest, fechas y notas originales." descriptionEn="Published OmniSpec versions: preview and latest channels, dates and original release notes.">
<Navbar/>
<main id="main-content" tabindex="-1" class="page-shell">
 <header class="page-heading"><p class="eyebrow" data-i18n="releases.eyebrow">{t['releases.eyebrow']}</p><h1 data-i18n="releases.title">{t['releases.title']}</h1><p class="body-copy" data-i18n="releases.intro">{t['releases.intro']}</p><div class="release-channels"><span><strong>preview</strong> {omniSpecRelease.version}</span><span><strong>latest</strong> {omniSpecRelease.stableVersion}</span></div></header>
 <div class="release-list" id="changelog-timeline">
 {main.map(release=><article class="release-entry" id={release.version}>
  <div class="release-meta"><Icon name={release.preview?'branch':'tag'} size={22}/><span class="release-badge" data-i18n={release.preview?'releases.preview':'releases.stable'}>{t[release.preview?'releases.preview':'releases.stable']}</span>{(['es','en'] as const).map(lang=><time datetime={release.date} data-locale={lang} hidden={lang==='en'}>{date(release.date,lang)}</time>)}</div>
  <div><h2>{release.version}</h2><p class="body-copy" data-i18n={release.preview?'releases.previewBody':'releases.stableBody'}>{t[release.preview?'releases.previewBody':'releases.stableBody']}</p><a href={release.url} class="quiet-link"><span data-i18n="releases.read">{t['releases.read']}</span><Icon name="arrow" size={17}/></a></div>
 </article>)}
 <section class="history-list"><h2 data-i18n="releases.history">{t['releases.history']}</h2>{history.map(release=><a href={release.url}><span>{release.version}{release.preview?' · Preview':''}</span>{(['es','en'] as const).map(lang=><time datetime={release.date} data-locale={lang} hidden={lang==='en'}>{date(release.date,lang)}</time>)}<Icon name="arrow" size={16}/></a>)}</section>
 <p class="release-source-note" data-locale="es">Fechas de publicación de GitHub. Los canales npm y la publicación de Preview se contrastaron el 26 de octubre de 2026. Las notas originales pueden conservar texto de preparación anterior al lanzamiento.</p>
 <p class="release-source-note" data-locale="en" hidden>GitHub publication dates. npm channels and the Preview release were checked on October 26, 2026. Original notes may retain preparation text written before publication.</p>
 <a href="https://github.com/brahiandres1999-oss/omni-spec/releases" class="quiet-link" data-i18n="releases.all">{t['releases.all']}</a>
 </div>
</main>
<Footer/>
</Layout>
