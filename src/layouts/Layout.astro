---
import '../styles/global.css';
import '@fontsource-variable/albert-sans/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import BackToTop from '../components/BackToTop.astro';
interface Props {
  title?: string;
  titleEn?: string;
  description?: string;
  descriptionEn?: string;
}
const {
  title = 'OmniSpec 0.9.0 — Motor Universal de Ingeniería Agéntica',
  titleEn = 'OmniSpec 0.9.0 — Universal Agentic Engineering Engine',
  description = 'Supera la burocracia documental del SDD tradicional. Motor Universal de Ingeniería Agéntica con contratos proporcionales (FIT v2), cartografía AST de dependencias, memoria SQLite FTS5 externa y verificación criptográfica HMAC.',
  descriptionEn = 'Transcend traditional SDD documentation bureaucracy. Universal Agentic Engineering Engine with proportional contracts (FIT v2), polyglot AST dependency cartography, zero-footprint external SQLite FTS5 memory, and HMAC cryptographic verification.'
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteUrl = Astro.site!.toString().replace(/\/$/, '');
const language = Astro.url.pathname.startsWith('/en/') ? 'en' : 'es';
const route = Astro.url.pathname.replace(/^\/en(?=\/)/, '');
const alternateEs = new URL(route, Astro.site).href;
const alternateEn = new URL('/en' + route, Astro.site).href;
const currentUrl = new URL(Astro.url.pathname, Astro.site).href;
const bannerUrl = siteUrl + base + '/assets/og-banner.png';
---
<!doctype html>
<html lang={language} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={base + '/favicon.svg'} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#09090b" />
    <title>{language === 'en' ? titleEn : title}</title>
    <meta name="description" content={language === 'en' ? descriptionEn : description} />
    <link rel="canonical" href={currentUrl} />
    <link rel="alternate" hreflang="es" href={alternateEs} />
    <link rel="alternate" hreflang="en" href={alternateEn} />
    <link rel="alternate" hreflang="x-default" href={alternateEs} />
    <meta property="og:locale" content={language === 'en' ? 'en_US' : 'es_ES'} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="OmniSpec — Universal Agentic Engineering Engine" />
    <meta name="twitter:image:alt" content="OmniSpec — Universal Agentic Engineering Engine" />
    <script is:inline>
      try {
        document.documentElement.classList.toggle('dark', localStorage.getItem('omni-theme') !== 'light');
      } catch {
        document.documentElement.dataset.preferences = 'session-only';
      }
    </script>
    <meta property="og:type" content="website" />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:title" content={language === 'en' ? titleEn : title} />
    <meta property="og:description" content={language === 'en' ? descriptionEn : description} />
    <meta property="og:image" content={bannerUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={language === 'en' ? titleEn : title} />
    <meta name="twitter:description" content={language === 'en' ? descriptionEn : description} />
    <meta name="twitter:image" content={bannerUrl} />
  </head>
  <body id="top" data-title-es={title} data-title-en={titleEn} data-description-es={description} data-description-en={descriptionEn}>
    <a class="skip-link" href="#main-content" data-i18n="skip">Saltar al contenido</a>
    <slot />
    <BackToTop />
    <script>import '../scripts/preferences';</script>
  </body>
</html>
