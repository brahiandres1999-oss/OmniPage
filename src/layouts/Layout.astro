---
import '../styles/global.css';
import BackToTop from '../components/BackToTop.astro';
interface Props {
  title?: string;
  titleEn?: string;
  description?: string;
  descriptionEn?: string;
}
const {
  title = 'OmniSpec 0.9.0 — Motor Universal de Ingeniería Agéntica',
  titleEn = 'OmniSpec 0.9.0 — Universal Agentic Engineering Engine',
  description = 'Supera la burocracia documental del SDD tradicional. Motor Universal de Ingeniería Agéntica con contratos proporcionales (FIT v2), cartografía AST de dependencias, memoria SQLite FTS5 externa y verificación criptográfica HMAC.',
  descriptionEn = 'Transcend traditional SDD documentation bureaucracy. Universal Agentic Engineering Engine with proportional contracts (FIT v2), polyglot AST dependency cartography, zero-footprint external SQLite FTS5 memory, and HMAC cryptographic verification.'
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteUrl = Astro.site!.toString().replace(/\/$/, '');
const currentUrl = new URL(Astro.url.pathname, Astro.site).href;
const bannerUrl = siteUrl + base + '/assets/omni-spec-banner.svg';
---
<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={base + '/favicon.svg'} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#09090b" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={currentUrl} />
    <script is:inline>
      try {
        document.documentElement.classList.toggle('dark', localStorage.getItem('omni-theme') !== 'light');
        document.documentElement.lang = localStorage.getItem('omni-lang') === 'en' ? 'en' : 'es';
      } catch {
        document.documentElement.dataset.preferences = 'session-only';
      }
    </script>
    <meta property="og:type" content="website" />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={bannerUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={bannerUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Albert+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body id="top" data-title-es={title} data-title-en={titleEn} data-description-es={description} data-description-en={descriptionEn}>
    <a class="skip-link" href="#main-content" data-i18n="skip">Saltar al contenido</a>
    <slot />
    <BackToTop />
    <script>import '../scripts/preferences';</script>
  </body>
</html>
